import { createPublicClient, http, defineChain } from "viem";
import { writeFileSync } from "node:fs";
import { createPerplApi } from "./perpl/api.js";
import { perplMainnet } from "./perpl/addresses.js";
import { fetchLedgerLogs, resolveAddresses } from "./leaderboard/indexer.js";
import { decodeLogs } from "./leaderboard/decode.js";
import { aggregate, rankAccounts } from "./leaderboard/ledger.js";
const out = process.argv[2];
const chain = defineChain({ id: 143, name: "Monad", nativeCurrency: { name: "MON", symbol: "MON", decimals: 18 }, rpcUrls: { default: { http: ["https://rpc.monad.xyz"] } }, contracts: { multicall3: { address: "0xcA11bde05977b3631167028862bE2a173976CA11" } } });
const client = createPublicClient({ chain, transport: http(), batch: { multicall: { wait: 20 } } });
const api = createPerplApi("https://app.perpl.xyz/api");
const markets = await api.getMarkets();
const decimals = new Map(markets.map((m) => [m.id, { price: m.priceDecimals, lot: m.sizeDecimals }]));
const head = await client.getBlockNumber();
const b0 = await client.getBlock({ blockNumber: head - 10_000n });
const b1 = await client.getBlock({ blockNumber: head });
const secPerBlock = Number(b1.timestamp - b0.timestamp) / 10_000;
const blocks = BigInt(Math.round(5_400 / secPerBlock));
console.log("secPerBlock", secPerBlock.toFixed(3), "blocks/24h", blocks);
const from = head - blocks;
let last = 0;
const logs = await fetchLedgerLogs(client, perplMainnet.exchange, from, head, { onProgress: (d, t) => { if (d - last >= 100) { last = d; console.log("progress", d, "/", t); } } });
console.log("logs", logs.length);
const { events, report } = decodeLogs(logs as never, decimals);
const stats0 = aggregate(events);
const ids = stats0.map((s) => s.accountId);
const resolved = await resolveAddresses(client, perplMainnet.exchange, ids);
const stats = aggregate(events, resolved);
const tFrom = Number((await client.getBlock({ blockNumber: from })).timestamp) * 1000;
const tTo = Number((await client.getBlock({ blockNumber: head })).timestamp) * 1000;
const tickers = new Map();
const candleVol: Record<string, number> = {};
for (const m of markets) {
  const cs = await api.getCandles(m, 60, tFrom, tTo);
  candleVol[m.symbol] = cs.filter((c) => c.time >= tFrom && c.time < tTo).reduce((sum, c) => sum + c.volumeUsd, 0);
}
const venue: Record<string, number> = {}; const taker: Record<string, number> = {}; const maker: Record<string, number> = {};
for (const m of markets) venue[m.symbol] = candleVol[m.symbol];
for (const e of events) if (e.kind === "fill") { const sym = markets.find((m) => m.id === e.perpId)?.symbol ?? String(e.perpId); (e.maker ? maker : taker)[sym] = ((e.maker ? maker : taker)[sym] ?? 0) + e.volumeUsd; }
writeFileSync(out, JSON.stringify({ head: head.toString(), from: from.toString(), secPerBlock, report, venue, taker, maker, stats }, null, 1));
console.log("DONE", JSON.stringify(report));
