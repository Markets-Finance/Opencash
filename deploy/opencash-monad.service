[Unit]
Description=OpenCash Monad backend
After=network-online.target
Wants=network-online.target

[Service]
User=opencash
WorkingDirectory=/opt/opencash-monad/backend
EnvironmentFile=/etc/opencash-monad.env
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/opencash-monad/backend/data

[Install]
WantedBy=multi-user.target
