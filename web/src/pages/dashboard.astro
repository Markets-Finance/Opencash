    </style>

    <script>
      import { isMeraError } from "@category-labs/mera";
      import {
        cancelOrder,
        minNotionalUsd,
        modifyOrder,
        moveUsd,
        placeLimitOrder,
        setLeverage,
        stockLogoUrl,
        updateIsolatedMargin,
        withdrawUsd,
        type BinPosition,
        type HlTif,
        type TradingAccount,
      } from "shared";
      import { createAccount, signIn } from "../scripts/mera";
      import { loadAssetRegistry } from "../scripts/assets";
      import {
        bins,
        loadPositions,
        loadTokens,
        loadUsdgBalance,
        openBin,
        sizeBinFor,
        sizeProposal,
        type Bin,
        type EntryStep,
        type HoodData,
      } from "../scripts/hood";
      import {
        fetchMarketCharts,
        fetchPortfolioHistory,
        snapshotPortfolio,
        type PortfolioSnapshot,
      } from "../scripts/backend";
      import {
        chartRanges,
        getExchange,
        loadCandles,
        loadDesk,
        loadTradeMarkets,
        logoFor,
        maxOrderNotionalUsd,
        type ChartRangeKey,
        type HlCandle,
        type HlDesk,
        type TradeMarket,
      } from "../scripts/hl";

      type AvatarModule = typeof import("../lib/avatar");
      let avatarModule: AvatarModule | null = null;
      async function avatars(): Promise<AvatarModule> {
        avatarModule ??= await import("../lib/avatar");
        return avatarModule;
      }

      const stepLabels: Record<EntryStep, string> = {
        approve: "Approving USDG…",
        swap: "Swapping…",
      };

      function usd(value: number): string {
        return `$${value.toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
      }
      function initial(text: string): string {
        return text.slice(0, 1).toUpperCase();
      }

      // Real logo when the registry has one (Robinhood's own CDN, no CORS
      // issue for <img>), falling back to the letter mark on a missing URL
      // or a broken image load. The fallback is a hidden sibling toggled by
      // onerror rather than a reconstructed HTML string — simpler, and it
      // can't be broken by quote/entity escaping.
      function markHtml(logoUrl: string | undefined, label: string): string {
        const letter = initial(label);
        if (!logoUrl) return `<span class="row-mark">${letter}</span>`;
        return `<span class="row-mark row-mark--logo"><img src="${logoUrl}" alt="" loading="lazy" onerror="this.remove();this.nextElementSibling.hidden=false" /><span hidden>${letter}</span></span>`;
      }

      // Looks the logo up in the centralized registry (assets.ts) by
      // symbol — callers never need to fetch or thread a token map just to
      // render a mark.
      function markForSymbol(symbol: string): string {
        return markHtml(stockLogoUrl(symbol), symbol);
      }

      function legStackHtml(symbols: string[]): string {
        return `<div class="leg-stack">${symbols.slice(0, 4).map(markForSymbol).join("")}</div>`;
      }

      // ---- Modal ----
      const modalOverlay = document.querySelector<HTMLElement>("[data-modal]")!;
      const modalPanel = document.querySelector<HTMLElement>("[data-modal-panel]")!;
      function openModal(html: string): HTMLElement {
        modalPanel.innerHTML = html;
        modalOverlay.hidden = false;
        modalPanel.querySelector<HTMLButtonElement>("[data-close]")?.addEventListener("click", closeModal);
        return modalPanel;
      }
      function closeModal() {
        modalOverlay.hidden = true;
        modalPanel.innerHTML = "";
      }
      modalOverlay.addEventListener("click", (event) => {
        if (event.target === modalOverlay) closeModal();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modalOverlay.hidden) closeModal();
      });

      // ---- Gate (sign-in) ----
      const gate = document.querySelector<HTMLElement>("[data-gate]")!;
      const dash = document.querySelector<HTMLElement>("[data-dash]")!;
      const gateStatus = document.querySelector<HTMLElement>("[data-gate-status]")!;
      const gateSignIn = document.querySelector<HTMLButtonElement>("[data-sign-in]")!;
      const gateCreate = document.querySelector<HTMLButtonElement>("[data-create]")!;
      const gateCreateForm = document.querySelector<HTMLFormElement>("[data-create-form]")!;

      let trader: TradingAccount | null = null;

      function sayGate(message: string, tone: "info" | "error" = "info") {
        gateStatus.textContent = message;
        gateStatus.dataset.tone = tone;
      }

      function explain(error: unknown): string {
        if (!isMeraError(error)) {
          return error instanceof Error ? error.message : "Something went wrong.";
        }
        const messages: Record<string, string> = {
          PRF_UNAVAILABLE:
            "This passkey cannot derive keys. Try a passkey stored in iCloud Keychain, Google Password Manager or 1Password.",
          PASSKEY_OPERATION_FAILED: "The passkey prompt was cancelled or unavailable.",
          CRYPTO_UNAVAILABLE: "This browser is missing a required crypto primitive.",
        };
        return messages[error.code] ?? `${error.code}: ${error.message}`;
      }

      async function enterDashboard(account: TradingAccount) {
        trader = account;
        gate.hidden = true;
        dash.hidden = false;
        void loadAssetRegistry();

        const { avatarDataUri, avatarSeed, shortenAddress } = await avatars();
        const nameEl = document.querySelector<HTMLElement>("[data-account-name]");
        const addressEl = document.querySelector<HTMLElement>("[data-address-text]");
        const avatarEl = document.querySelector<HTMLImageElement>("[data-account-avatar]");
        const topbarAddressEl = document.querySelector<HTMLElement>("[data-topbar-address-text]");
        if (nameEl) nameEl.textContent = "Trader";
        if (addressEl) addressEl.textContent = shortenAddress(account.address);
        if (topbarAddressEl) topbarAddressEl.textContent = shortenAddress(account.address);
        if (avatarEl) {
          avatarEl.src = avatarDataUri(avatarSeed(account.address, 0));
          avatarEl.alt = `Avatar for ${shortenAddress(account.address)}`;
        }

        initHome();
      }

      async function run(action: () => Promise<TradingAccount>, pending: string) {
        sayGate(pending);
        try {
          await enterDashboard(await action());
        } catch (error) {
          sayGate(explain(error), "error");
        }
      }

      gateSignIn.addEventListener("click", () => run(signIn, "Waiting for your passkey…"));
      gateCreate.addEventListener("click", () => {
        gateCreateForm.hidden = !gateCreateForm.hidden;
        if (!gateCreateForm.hidden) gateCreateForm.querySelector("input")?.focus();
      });
      gateCreateForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(gateCreateForm);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        void run(() => createAccount(email, name), "Creating a passkey…");
      });

      // ---- Tabs ----
      const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const panels = new Map(
        Array.from(document.querySelectorAll<HTMLElement>("[data-panel]")).map((el) => [
          el.dataset.panel!,
          el,
        ]),
      );
      const loadedPanels = new Set<string>();

      function activateTab(key: string) {
        dash.dataset.tab = key;
        for (const button of tabButtons) {
          const active = button.dataset.tab === key;
          button.setAttribute("aria-selected", String(active));
        }
        for (const [panelKey, el] of panels) {
          el.hidden = panelKey !== key;
        }
        if (!loadedPanels.has(key)) {
          loadedPanels.add(key);
          if (key === "bins") void initBins();
          if (key === "trade") void initTrade();
          if (key === "account") void initAccount();
        }
      }
      tabButtons.forEach((button) =>
        button.addEventListener("click", () => activateTab(button.dataset.tab!)),
      );
      document.querySelectorAll<HTMLButtonElement>("[data-goto]").forEach((button) =>
        button.addEventListener("click", () => activateTab(button.dataset.goto!)),
      );
      const accountMenu = document.querySelector<HTMLElement>("[data-account-menu]")!;
      const accountMenuButton = document.querySelector<HTMLButtonElement>("[data-topbar-address]")!;
      const accountMenuList = document.querySelector<HTMLElement>("[data-account-menu-list]")!;

      function setAccountMenu(open: boolean) {
        accountMenuList.hidden = !open;
        accountMenuButton.setAttribute("aria-expanded", String(open));
      }

      function disconnect() {
        trader?.end();
        trader = null;
        location.reload();
      }

      accountMenuButton.addEventListener("click", () => setAccountMenu(accountMenuList.hidden));
      document.addEventListener("click", (event) => {
        if (!accountMenu.contains(event.target as Node)) setAccountMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setAccountMenu(false);
      });
      document
        .querySelector<HTMLButtonElement>("[data-disconnect]")!
        .addEventListener("click", disconnect);

      const globalSearchInput = document.querySelector<HTMLInputElement>("[data-global-search]")!;
      globalSearchInput.addEventListener("input", () => {
        const value = globalSearchInput.value;
        activateTab("trade");
        tradeQuery = value.trim().toLowerCase();
        if (tradeMarkets.length > 0) renderHlAssets();
      });

      // ---- Shared market data ----
      let hoodData: HoodData | null = null;
      let hoodDataPromise: Promise<HoodData> | null = null;
      function getHoodData(): Promise<HoodData> {
        hoodDataPromise ??= loadTokens().then((data) => (hoodData = data));
        return hoodDataPromise;
      }

      let positionsCache: BinPosition[] | null = null;
      async function getPositions(force = false): Promise<BinPosition[]> {
        if (!trader) return [];
        if (positionsCache && !force) return positionsCache;
        const data = await getHoodData();
        positionsCache = await loadPositions(trader.address, data.tokens);
        return positionsCache;
      }

      // ---- Home ----
      // Featured symbols for Top Assets / the ticker row: every symbol used
      // across the bin catalog, deduped, in catalog order.
      const featuredSymbols = [...new Set(bins.flatMap((bin) => bin.legs.map((leg) => leg.symbol)))];

      function pct(value: number): string {
        return `${value >= 0 ? "+" : ""}${value.toFixed(2)}%`;
      }
      function changeClass(value: number): string {
        return value >= 0 ? "change-up" : "change-down";
      }

      function renderPositionsTable(container: HTMLElement, positions: BinPosition[]) {
        if (positions.length === 0) {
          container.className = "empty";
          container.textContent = "No open positions yet. Open a bin to take a framing.";
          return;
        }
        container.className = "table-wrap";
        const rows = positions
          .map(
            (position) => `
              <tr>
                <td><div class="cell-identity">${legStackHtml(position.legs.map((leg) => leg.symbol))}${position.bin.name}</div></td>
                <td class="cell-muted">${position.legs.map((leg) => leg.symbol).join(", ")}</td>
                <td class="cell-value">${usd(position.valueUsdg)}</td>
              </tr>
            `,
          )
          .join("");
        container.innerHTML = `
          <table class="data-table">
            <thead><tr><th>Bin</th><th>Legs</th><th style="text-align:right">Value</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
        `;
      }

      function renderTopAssets(
        container: HTMLElement,
        symbols: string[],
        charts: Record<string, { price: number; changePercent: number }>,
      ) {
        container.className = "asset-list";
        container.innerHTML = symbols
          .map((symbol) => {
            const chart = charts[symbol];
            return `
              <div class="asset-row">
                ${markForSymbol(symbol)}
                <span class="asset-row__identity">${symbol}</span>
                <span class="asset-row__price">${chart ? usd(chart.price) : "—"}</span>
                <span class="asset-row__change ${chart ? changeClass(chart.changePercent) : ""}">${chart ? pct(chart.changePercent) : "—"}</span>
              </div>
            `;
          })
          .join("");
      }

      function renderTicker(
        container: HTMLElement,
        symbols: string[],
        charts: Record<string, { price: number; changePercent: number }>,
      ) {
        container.className = "ticker-row";
        container.innerHTML = symbols
          .map((symbol) => {
            const chart = charts[symbol];
            return `
              <div class="ticker-card">
                <div class="ticker-card__head">
                  ${markForSymbol(symbol)}
                  <span class="ticker-card__symbol">${symbol}</span>
                </div>
                <span class="ticker-card__price">${chart ? usd(chart.price) : "—"}</span>
                <span class="ticker-card__change ${chart ? changeClass(chart.changePercent) : ""}">${chart ? `${pct(chart.changePercent)} today` : "—"}</span>
              </div>
            `;
          })
          .join("");
      }

      function filterHistoryByRange(
        history: PortfolioSnapshot[],
        range: "1d" | "7d" | "30d" | "all",
      ): PortfolioSnapshot[] {
        if (range === "all") return history;
        const days = range === "1d" ? 1 : range === "7d" ? 7 : 30;
        const cutoff = Date.now() - days * 86_400_000;
        return history.filter((snapshot) => Date.parse(snapshot.createdAt) >= cutoff);
      }

      function renderLineChart(container: HTMLElement, values: number[], emptyMessage: string) {
        if (values.length < 2) {
          container.innerHTML = `<div class="chart-empty">${emptyMessage}</div>`;
          return;
        }
        const min = Math.min(...values);
        const max = Math.max(...values);
        const range = max - min || 1;
        const w = 600;
        const h = 200;
        const pad = 8;
        const points = values
          .map((value, i) => {
            const x = pad + (i / (values.length - 1)) * (w - pad * 2);
            const y = h - pad - ((value - min) / range) * (h - pad * 2);
            return `${x.toFixed(1)},${y.toFixed(1)}`;
          })
          .join(" ");
        container.innerHTML = `
          <svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
            <polyline points="${points}" fill="none" stroke="#7165ed" stroke-width="2" />
          </svg>
        `;
      }

      function renderPortfolioChart(container: HTMLElement, snapshots: PortfolioSnapshot[]) {
        renderLineChart(
          container,
          snapshots.map((s) => s.totalValue),
          "Portfolio history builds up as you use the app — each visit adds a real data point. Check back soon.",
        );
      }

      async function initHome() {
        if (!trader) return;
        const balanceEl = document.querySelector<HTMLElement>("[data-home-balance]")!;
        const updatedEl = document.querySelector<HTMLElement>("[data-home-updated]")!;
        const refreshButton = document.querySelector<HTMLButtonElement>("[data-home-refresh]")!;
        const topAssetsEl = document.querySelector<HTMLElement>("[data-top-assets]")!;
        const tickerEl = document.querySelector<HTMLElement>("[data-ticker-row]")!;
        const portfolioValueEl = document.querySelector<HTMLElement>("[data-portfolio-value]")!;
        const portfolioChangeEl = document.querySelector<HTMLElement>("[data-portfolio-change]")!;
        const chartEl = document.querySelector<HTMLElement>("[data-portfolio-chart]")!;
        const positionsTableEl = document.querySelector<HTMLElement>("[data-home-positions-table]")!;
        const rangeButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-portfolio-range] [data-range]"),
        );

        let currentBalance = 0;
        await loadAssetRegistry().catch(() => {});

        async function refreshBalance() {
          currentBalance = await loadUsdgBalance(trader!.address);
          balanceEl.textContent = usd(currentBalance);
          updatedEl.textContent = new Date().toLocaleTimeString();
        }
        refreshButton.addEventListener("click", () => void refreshBalance().catch(() => {}));
        await refreshBalance().catch(() => {
          balanceEl.textContent = "—";
        });

        const positions = await getPositions().catch(() => [] as BinPosition[]);
        const positionsValue = positions.reduce((sum, p) => sum + p.valueUsdg, 0);
        renderPositionsTable(positionsTableEl, positions);
        portfolioValueEl.textContent = usd(currentBalance + positionsValue);

        void snapshotPortfolio({
          owner: trader.address,
          usdgBalance: currentBalance,
          positionsValue,
        }).catch(() => {});

        let history: PortfolioSnapshot[] = [];
        try {
          history = await fetchPortfolioHistory(trader.address);
        } catch {
          // No history yet — the chart renders its own empty state.
        }

        let currentRange: "1d" | "7d" | "30d" | "all" = "1d";
        function renderChart() {
          const filtered = filterHistoryByRange(history, currentRange);
          renderPortfolioChart(chartEl, filtered);
          if (filtered.length >= 2) {
            const change =
              ((filtered[filtered.length - 1].totalValue - filtered[0].totalValue) /
                (filtered[0].totalValue || 1)) *
              100;
            portfolioChangeEl.textContent = `${pct(change)} this range`;
            portfolioChangeEl.className = `chart-change ${changeClass(change)}`;
          } else {
            portfolioChangeEl.textContent = "";
            portfolioChangeEl.className = "chart-change";
          }
        }
        rangeButtons.forEach((button) =>
          button.addEventListener("click", () => {
            currentRange = button.dataset.range as "1d" | "7d" | "30d" | "all";
            rangeButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            renderChart();
          }),
        );
        renderChart();

        try {
          const charts = await fetchMarketCharts(featuredSymbols);
          renderTopAssets(topAssetsEl, featuredSymbols, charts);
          renderTicker(tickerEl, featuredSymbols.slice(0, 4), charts);
        } catch (error) {
          const message = error instanceof Error ? error.message : String(error);
          topAssetsEl.className = "error-text";
          topAssetsEl.textContent = message;
          tickerEl.className = "error-text";
          tickerEl.textContent = message;
        }
      }

      // ---- Bins ----
      async function initBins() {
        const carousel = document.querySelector<HTMLElement>("[data-bins-carousel]")!;
        carousel.className = "carousel";
        carousel.innerHTML = "";
        await loadAssetRegistry().catch(() => {});
        for (const bin of bins) {
          const card = document.createElement("button");
          card.type = "button";
          card.className = "tile-card";
          card.innerHTML = `
            ${legStackHtml(bin.legs.map((leg) => leg.symbol))}
            <span class="tile-card__name">${bin.name}</span>
            <span class="tile-card__thesis">${bin.thesis}</span>
            <div class="tile-card__legs">
              ${bin.legs.map((leg) => `<div class="tile-leg"><span>${leg.symbol}</span><span>${(leg.weightBps / 100).toFixed(0)}%</span></div>`).join("")}
            </div>
          `;
          card.addEventListener("click", () => openBinModal(bin));
          carousel.appendChild(card);
        }
      }

      function openBinModal(bin: Bin) {
        const detail = openModal(`
          <div class="modal__head">
            <div class="modal__identity">${legStackHtml(bin.legs.map((leg) => leg.symbol))}<span class="modal__title">${bin.name}</span></div>
            <button type="button" class="modal__close" data-close>×</button>
          </div>
          <p class="quote-line">${bin.thesis}</p>
          <div class="amount-row">
            <span>$</span>
            <input type="number" min="0" step="any" placeholder="0" data-bin-amount />
          </div>
          <button type="button" class="btn btn--primary" data-bin-size>Size this bin</button>
          <div data-bin-sizing></div>
          <p class="status-line" data-bin-status></p>
        `);
        const status = detail.querySelector<HTMLElement>("[data-bin-status]")!;
        const sizingEl = detail.querySelector<HTMLElement>("[data-bin-sizing]")!;
        const amountInput = detail.querySelector<HTMLInputElement>("[data-bin-amount]")!;

        detail.querySelector<HTMLButtonElement>("[data-bin-size]")!.addEventListener("click", async () => {
          const amount = Number(amountInput.value);
          if (!(amount > 0)) {
            status.textContent = "Enter an amount greater than 0.";
            status.dataset.tone = "error";
            return;
          }
          status.textContent = "Pricing every leg…";
          status.dataset.tone = "";
          sizingEl.innerHTML = "";
          try {
            const data = await getHoodData();
            const { sized, issues } = await sizeBinFor(bin, amount, data.tokens);
            status.textContent = "";
            if (sized.legs.length === 0) {
              sizingEl.innerHTML = `<p class="warn-line">${issues.map((i) => i.detail).join(" · ") || "No legs could be sized."}</p>`;
              return;
            }
            sizingEl.innerHTML =
              sized.legs
                .map((leg) => `<div class="leg-row"><span>${leg.leg.symbol}</span><span>${usd(leg.usdgIn)}</span></div>`)
                .join("") +
              (issues.length > 0 ? `<p class="warn-line">${issues.map((i) => i.detail).join(" · ")}</p>` : "") +
              `<button type="button" class="btn btn--primary" data-bin-confirm style="margin-top:12px">Open bin with my passkey</button>`;
            sizingEl.querySelector<HTMLButtonElement>("[data-bin-confirm]")!.addEventListener("click", async () => {
              if (!trader) return;
              const button = sizingEl.querySelector<HTMLButtonElement>("[data-bin-confirm]")!;
              button.disabled = true;
              status.dataset.tone = "";
              try {
                status.textContent = "Waiting for your passkey…";
                await openBin(trader, sized, (step) => (status.textContent = stepLabels[step]));
                status.textContent = `Opened ${bin.name}.`;
                await getPositions(true);
                void initHome();
              } catch (error) {
                status.dataset.tone = "error";
                status.textContent = error instanceof Error ? error.message : String(error);
                button.disabled = false;
              }
            });
          } catch (error) {
            status.dataset.tone = "error";
            status.textContent = error instanceof Error ? error.message : String(error);
          }
        });
      }

      // ---- Trade (Hyperliquid) ----
      let tradeMarkets: TradeMarket[] = [];
      let selectedMarket: TradeMarket | null = null;
      let tradeQuery = "";
      let chartRange: ChartRangeKey = "1d";
      let deskTab: "positions" | "orders" | "fills" = "positions";
      let desk: HlDesk | null = null;
      let ticketSide: "buy" | "sell" = "buy";

      const hlBalance = document.querySelector<HTMLElement>("[data-hl-balance]")!;
      const hlUpdated = document.querySelector<HTMLElement>("[data-hl-updated]")!;
      const hlWalletNote = document.querySelector<HTMLElement>("[data-hl-wallet-note]")!;
      const hlAssets = document.querySelector<HTMLElement>("[data-hl-assets]")!;
      const hlTicker = document.querySelector<HTMLElement>("[data-hl-ticker]")!;
      const hlChart = document.querySelector<HTMLElement>("[data-hl-chart]")!;
      const hlAxis = document.querySelector<HTMLElement>("[data-hl-axis]")!;
      const hlChartLabel = document.querySelector<HTMLElement>("[data-hl-chart-label]")!;
      const hlChartValue = document.querySelector<HTMLElement>("[data-hl-chart-value]")!;
      const hlChartChange = document.querySelector<HTMLElement>("[data-hl-chart-change]")!;
      const hlDesk = document.querySelector<HTMLElement>("[data-hl-desk]")!;
      const hlDeskStatus = document.querySelector<HTMLElement>("[data-hl-desk-status]")!;
      const ticket = document.querySelector<HTMLElement>("[data-hl-ticket]")!;
      const ticketTitle = ticket.querySelector<HTMLElement>("[data-hl-ticket-title]")!;
      const ticketPrice = ticket.querySelector<HTMLInputElement>("[data-ticket-price]")!;
      const ticketNotional = ticket.querySelector<HTMLInputElement>("[data-ticket-notional]")!;
      const ticketPerp = ticket.querySelector<HTMLElement>("[data-ticket-perp]")!;
      const ticketLeverage = ticket.querySelector<HTMLInputElement>("[data-ticket-leverage]")!;
      const ticketMargin = ticket.querySelector<HTMLSelectElement>("[data-ticket-margin]")!;
      const ticketTif = ticket.querySelector<HTMLSelectElement>("[data-ticket-tif]")!;
      const ticketReduce = ticket.querySelector<HTMLInputElement>("[data-ticket-reduce]")!;
      const ticketSize = ticket.querySelector<HTMLElement>("[data-ticket-size]")!;
      const ticketSubmit = ticket.querySelector<HTMLButtonElement>("[data-ticket-submit]")!;
      const ticketStatus = ticket.querySelector<HTMLElement>("[data-ticket-status]")!;

      function esc(text: string): string {
        return text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
      }
      function px(value: number): string {
        const digits = value >= 100 ? 2 : value >= 1 ? 4 : 6;
        return `$${value.toLocaleString(undefined, { maximumFractionDigits: digits })}`;
      }
      function dayChange(market: TradeMarket): number {
        return market.prevDayPx > 0 ? ((market.markPx - market.prevDayPx) / market.prevDayPx) * 100 : 0;
      }
      function marketFor(coin: string): TradeMarket | undefined {
        return tradeMarkets.find((m) => m.coin === coin);
      }
      function marketMark(coin: string): string {
        const market = marketFor(coin);
        const symbol = market?.symbol ?? coin.split(":").pop()!;
        return markHtml(market ? logoFor(market) : undefined, esc(symbol));
      }
      function errorText(error: unknown): string {
        return error instanceof Error ? error.message : String(error);
      }
      function say(el: HTMLElement, message: string, tone: "info" | "error" = "info") {
        el.textContent = message;
        el.dataset.tone = tone;
      }

      function renderHlAssets() {
        const list = tradeQuery
          ? tradeMarkets
              .filter((m) => m.coin.toLowerCase().includes(tradeQuery) || m.symbol.toLowerCase().includes(tradeQuery))
              .slice(0, 30)
          : tradeMarkets.filter((m) => m.kind === "perp").slice(0, 12);
        if (list.length === 0) {
          hlAssets.className = "empty";
          hlAssets.textContent = "No Hyperliquid markets match that search.";
          return;
        }
        hlAssets.className = "asset-list";
        hlAssets.innerHTML = list
          .map((m) => {
            const change = dayChange(m);
            return `
              <button type="button" class="asset-row hl-asset ${m === selectedMarket ? "hl-asset--active" : ""}" data-coin="${esc(m.coin)}">
                ${marketMark(m.coin)}
                <span class="asset-row__identity">${esc(m.symbol)}<span class="hl-asset__detail">${esc(m.detail)}</span></span>
                <span class="asset-row__price hl-mono">${px(m.markPx)}</span>
                <span class="asset-row__change ${changeClass(change)}">${pct(change)}</span>
              </button>
            `;
          })
          .join("");
        hlAssets.querySelectorAll<HTMLButtonElement>("[data-coin]").forEach((button) =>
          button.addEventListener("click", () => selectMarket(button.dataset.coin!)),
        );
      }

      function renderHlTicker() {
        const featured = [
          ...(selectedMarket ? [selectedMarket] : []),
          ...tradeMarkets.filter((m) => m.kind === "perp" && m !== selectedMarket),
        ].slice(0, 4);
        hlTicker.className = "ticker-row";
        hlTicker.innerHTML = featured
          .map((m) => {
            const change = dayChange(m);
            return `
              <button type="button" class="ticker-card ${m === selectedMarket ? "ticker-card--active" : ""}" data-coin="${esc(m.coin)}">
                <div class="ticker-card__head">
                  ${marketMark(m.coin)}
                  <span class="ticker-card__symbol">${esc(m.symbol)} · ${esc(m.detail)}</span>
                </div>
                <span class="ticker-card__price hl-mono">${px(m.markPx)}</span>
                <span class="ticker-card__change ${changeClass(change)}">${pct(change)} vs 24h</span>
              </button>
            `;
          })
          .join("");
        hlTicker.querySelectorAll<HTMLButtonElement>("[data-coin]").forEach((button) =>
          button.addEventListener("click", () => selectMarket(button.dataset.coin!)),
        );
      }

      function drawCandleChart(candles: HlCandle[]) {
        const values = candles.map((c) => c.close);
        const min = Math.min(...values);
        const max = Math.max(...values);
        const spread = max - min || 1;
        const w = 600;
        const h = 240;
        const pad = 8;
        const xs = values.map((_, i) => pad + (i / (values.length - 1)) * (w - pad * 2));
        const ys = values.map((v) => h - pad - ((v - min) / spread) * (h - pad * 2));
        const line = xs.map((x, i) => `${x.toFixed(1)},${ys[i].toFixed(1)}`).join(" ");
        hlChart.innerHTML = `
          <svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
            <defs>
              <linearGradient id="hl-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#3ddc84" stop-opacity="0.22" />
                <stop offset="1" stop-color="#3ddc84" stop-opacity="0" />
              </linearGradient>
            </defs>
            <polygon points="${pad},${h} ${line} ${w - pad},${h}" fill="url(#hl-fill)" />
            <polyline points="${line}" fill="none" stroke="#3ddc84" stroke-width="2" vector-effect="non-scaling-stroke" />
            <line data-cross y1="0" y2="${h}" stroke="#5b6662" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" visibility="hidden" />
          </svg>
          <span class="hl-chart__dot" hidden></span>
          <div class="hl-chart__tip hl-mono" hidden></div>
        `;
        const cross = hlChart.querySelector<SVGLineElement>("[data-cross]")!;
        const dot = hlChart.querySelector<HTMLElement>(".hl-chart__dot")!;
        const tip = hlChart.querySelector<HTMLElement>(".hl-chart__tip")!;
        const short = chartRanges[chartRange].spanMs <= 86_400_000;
        const stamp = (time: number) =>
          short
            ? new Date(time).toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" })
            : new Date(time).toLocaleDateString(undefined, { month: "short", day: "numeric" });
        hlChart.onmousemove = (event) => {
          const rect = hlChart.getBoundingClientRect();
          const ratio = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
          const i = Math.round(ratio * (values.length - 1));
          const left = (xs[i] / w) * 100;
          cross.setAttribute("x1", String(xs[i]));
          cross.setAttribute("x2", String(xs[i]));
          cross.setAttribute("visibility", "visible");
          dot.hidden = false;
          dot.style.left = `${left}%`;
          dot.style.top = `${(ys[i] / h) * 100}%`;
          const change = ((values[i] - candles[0].open) / candles[0].open) * 100;
          tip.hidden = false;
          tip.style.left = `${Math.min(85, Math.max(15, left))}%`;
          tip.innerHTML = `${stamp(candles[i].time)} · ${px(values[i])} <span class="${changeClass(change)}">${pct(change)}</span>`;
        };
        hlChart.onmouseleave = () => {
          cross.setAttribute("visibility", "hidden");
          dot.hidden = true;
          tip.hidden = true;
        };
        hlAxis.innerHTML = [0, 1, 2, 3, 4]
          .map((k) => `<span>${stamp(candles[Math.round((k * (candles.length - 1)) / 4)].time)}</span>`)
          .join("");
      }

      async function renderHlChart() {
        const market = selectedMarket;
        if (!market) return;
        hlChartLabel.textContent = `${market.symbol} · ${market.detail}`;
        hlChartValue.textContent = px(market.markPx);
        hlChartChange.textContent = "";
        hlAxis.innerHTML = "";
        hlChart.onmousemove = null;
        hlChart.innerHTML = `<div class="chart-empty">Loading…</div>`;
        let candles: HlCandle[];
        try {
          candles = await loadCandles(market.coin, chartRange);
        } catch {
          if (selectedMarket === market) hlChart.innerHTML = `<div class="chart-empty">Chart unavailable right now.</div>`;
          return;
        }
        if (selectedMarket !== market) return;
        if (candles.length < 2) {
          hlChart.innerHTML = `<div class="chart-empty">No trades in this range on Hyperliquid testnet.</div>`;
          return;
        }
        const change = ((candles[candles.length - 1].close - candles[0].open) / candles[0].open) * 100;
        hlChartChange.textContent = `${pct(change)} this range`;
        hlChartChange.className = `chart-change ${changeClass(change)}`;
        drawCandleChart(candles);
      }

      function renderTicket() {
        const market = selectedMarket;
        const exchange = getExchange();
        ticketTitle.textContent = market ? `Order · ${market.symbol}` : "Order";
        ticketPerp.hidden = market?.kind !== "perp";
        if (market) ticketLeverage.max = String(market.maxLeverage);
        const price = Number(ticketPrice.value);
        const notional = Number(ticketNotional.value);
        ticketSize.textContent =
          market && price > 0 && notional > 0
            ? `≈ ${(notional / price).toFixed(market.szDecimals)} ${market.symbol} · min $${minNotionalUsd}, max $${maxOrderNotionalUsd}`
            : `Min $${minNotionalUsd}, max $${maxOrderNotionalUsd} per order`;
        ticket
          .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLButtonElement>("input, select, button")
          .forEach((el) => (el.disabled = !exchange || !market));
        ticketSubmit.textContent = exchange ? "Place order" : "Connect wallet to trade";
      }

      function selectMarket(coin: string) {
        const market = marketFor(coin);
        if (!market) return;
        selectedMarket = market;
        ticketPrice.value = String(market.markPx);
        ticketLeverage.value = String(Math.min(Number(ticketLeverage.value) || 1, market.maxLeverage));
        say(ticketStatus, "");
        renderHlAssets();
        renderHlTicker();
        renderTicket();
        void renderHlChart();
      }

      function actionButton(label: string, data: string): string {
        return `<button type="button" class="chip" ${data} ${getExchange() ? "" : "disabled"}>${label}</button>`;
      }

      function deskTable(head: string[], rows: string[]): string {
        return `
          <table class="data-table">
            <thead><tr>${head.map((h, i) => `<th${i > 0 ? ' style="text-align:right"' : ""}>${h}</th>`).join("")}</tr></thead>
            <tbody>${rows.join("")}</tbody>
          </table>
        `;
      }

      function assetCell(coin: string): string {
        const market = marketFor(coin);
        return `<td><div class="cell-identity">${marketMark(coin)}<span>${esc(market?.symbol ?? coin)}<span class="hl-asset__detail">${esc(market?.detail ?? coin)}</span></span></div></td>`;
      }

      function renderDesk() {
        if (!desk) return;
        const empty = (message: string) => {
          hlDesk.className = "empty";
          hlDesk.textContent = message;
        };
        if (deskTab === "positions") {
          if (desk.positions.length === 0) return empty("No open positions on Hyperliquid testnet for this address.");
          hlDesk.className = "table-wrap";
          hlDesk.innerHTML = deskTable(
            ["Asset", "Size", "Entry", "Value", "uPnL", "Liq.", "Margin", ""],
            desk.positions.map(
              (p) => `
                <tr>
                  ${assetCell(p.coin)}
                  <td class="cell-value ${changeClass(p.size)}">${p.size > 0 ? "Long" : "Short"} ${Math.abs(p.size)}</td>
                  <td class="cell-value hl-mono">${px(p.entryPx)}</td>
                  <td class="cell-value hl-mono">${usd(p.positionValue)}</td>
                  <td class="cell-value hl-mono ${changeClass(p.unrealizedPnl)}">${usd(p.unrealizedPnl)}</td>
                  <td class="cell-value hl-mono">${p.liquidationPx === null ? "—" : px(p.liquidationPx)}</td>
                  <td class="cell-value">${usd(p.marginUsed)} · ${p.leverage}x ${p.leverageType}</td>
                  <td><div class="hl-actions">${
                    p.leverageType === "isolated"
                      ? actionButton("+ Margin", `data-margin="add" data-coin="${esc(p.coin)}"`) +
                        actionButton("− Margin", `data-margin="remove" data-coin="${esc(p.coin)}"`)
                      : ""
                  }</div></td>
                </tr>
              `,
            ),
          );
        } else if (deskTab === "orders") {
          if (desk.orders.length === 0) return empty("No open orders.");
          hlDesk.className = "table-wrap";
          hlDesk.innerHTML = deskTable(
            ["Asset", "Side", "Price", "Size", "Notional", "Type", ""],
            desk.orders.map(
              (o) => `
                <tr>
                  ${assetCell(o.coin)}
                  <td class="cell-value ${o.isBuy ? "change-up" : "change-down"}">${o.isBuy ? "Buy" : "Sell"}</td>
                  <td class="cell-value hl-mono">${px(o.price)}</td>
                  <td class="cell-value hl-mono">${o.size}</td>
                  <td class="cell-value hl-mono">${usd(o.price * o.size)}</td>
                  <td class="cell-value cell-muted">${o.tif ?? "—"}${o.reduceOnly ? " · RO" : ""}</td>
                  <td><div class="hl-actions">${actionButton("Edit", `data-edit="${o.oid}"`)}${actionButton("Cancel", `data-cancel="${o.oid}"`)}</div></td>
                </tr>
              `,
            ),
          );
        } else {
          if (desk.fills.length === 0) return empty("No fills yet.");
          hlDesk.className = "table-wrap";
          hlDesk.innerHTML = deskTable(
            ["Asset", "Time", "Direction", "Price", "Size", "Fee", "Closed PnL"],
            desk.fills.map(
              (f) => `
                <tr>
                  ${assetCell(f.coin)}
                  <td class="cell-value cell-muted">${new Date(f.time).toLocaleString()}</td>
                  <td class="cell-value">${esc(f.dir)}</td>
                  <td class="cell-value hl-mono">${px(f.price)}</td>
                  <td class="cell-value hl-mono">${f.size}</td>
                  <td class="cell-value hl-mono">${usd(f.fee)}</td>
                  <td class="cell-value hl-mono ${changeClass(f.closedPnl)}">${usd(f.closedPnl)}</td>
                </tr>
              `,
            ),
          );
        }
        hlDesk.querySelectorAll<HTMLButtonElement>("[data-cancel]").forEach((button) =>
          button.addEventListener("click", () => cancelDeskOrder(Number(button.dataset.cancel))),
        );
        hlDesk.querySelectorAll<HTMLButtonElement>("[data-edit]").forEach((button) =>
          button.addEventListener("click", () => openEditOrder(Number(button.dataset.edit))),
        );
        hlDesk.querySelectorAll<HTMLButtonElement>("[data-margin]").forEach((button) =>
          button.addEventListener("click", () => openMarginModal(button.dataset.coin!, button.dataset.margin === "add")),
        );
      }

      async function refreshDesk() {
        if (!trader) return;
        try {
          desk = await loadDesk(trader.address);
          hlBalance.textContent = `$${desk.equity.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          hlUpdated.textContent = desk.updatedAt.toLocaleTimeString();
          renderDesk();
        } catch (error) {
          desk = null;
          hlBalance.textContent = "—";
          hlDesk.className = "error-text";
          hlDesk.textContent = errorText(error);
        }
      }

      async function runWrite(status: HTMLElement, pending: string, action: () => Promise<unknown>, done: string) {
        say(status, pending);
        try {
          await action();
          say(status, done);
          await refreshDesk();
          return true;
        } catch (error) {
          say(status, errorText(error), "error");
          return false;
        }
      }

      function cancelDeskOrder(oid: number) {
        const exchange = getExchange();
        const order = desk?.orders.find((o) => o.oid === oid);
        const market = order && marketFor(order.coin);
        if (!exchange || !market) return;
        void runWrite(hlDeskStatus, "Cancelling…", () => cancelOrder(exchange, market.assetId, oid), "Order cancelled.");
      }

      function modalForm(title: string, fields: string, submit: string): HTMLElement {
        return openModal(`
          <div class="modal__head">
            <span class="modal__title">${title}</span>
            <button type="button" class="modal__close" data-close>×</button>
          </div>
          <div class="hl-ticket">${fields}</div>
          <button type="button" class="btn btn--primary" style="margin-top:16px" data-modal-submit>${submit}</button>
          <p class="status-line" data-modal-status></p>
        `);
      }

      function onModalSubmit(panel: HTMLElement, run: (status: HTMLElement) => Promise<boolean>) {
        const button = panel.querySelector<HTMLButtonElement>("[data-modal-submit]")!;
        const status = panel.querySelector<HTMLElement>("[data-modal-status]")!;
        button.addEventListener("click", async () => {
          button.disabled = true;
          if (await run(status)) closeModal();
          else button.disabled = false;
        });
      }

      function openEditOrder(oid: number) {
        const exchange = getExchange();
        const order = desk?.orders.find((o) => o.oid === oid);
        const market = order && marketFor(order.coin);
        if (!exchange || !order || !market) return;
        const panel = modalForm(
          `Edit ${esc(market.symbol)} ${order.isBuy ? "buy" : "sell"}`,
          `<label class="field"><span>Limit price</span><input type="number" step="any" value="${order.price}" data-edit-price /></label>
           <label class="field"><span>Size (${esc(market.symbol)})</span><input type="number" step="any" value="${order.size}" data-edit-size /></label>`,
          "Save changes",
        );
        onModalSubmit(panel, (status) => {
          const price = Number(panel.querySelector<HTMLInputElement>("[data-edit-price]")!.value);
          const size = Number(panel.querySelector<HTMLInputElement>("[data-edit-size]")!.value);
          const tif: HlTif = order.tif === "Alo" || order.tif === "Ioc" ? order.tif : "Gtc";
          return runWrite(
            status,
            "Updating order…",
            () =>
              modifyOrder(exchange, oid, {
                assetId: market.assetId,
                isBuy: order.isBuy,
                price,
                size,
                szDecimals: market.szDecimals,
                kind: market.kind,
                tif,
                reduceOnly: order.reduceOnly,
                maxNotionalUsd: maxOrderNotionalUsd,
              }),
            "Order updated.",
          );
        });
      }

      function openMarginModal(coin: string, add: boolean) {
        const exchange = getExchange();
        const position = desk?.positions.find((p) => p.coin === coin);
        const market = marketFor(coin);
        if (!exchange || !position || !market) return;
        const panel = modalForm(
          `${add ? "Add" : "Remove"} ${esc(market.symbol)} margin`,
          `<p class="quote-line">Isolated margin now ${usd(position.marginUsed)}.</p>
           <label class="field"><span>Amount (USD)</span><input type="number" min="0" step="any" data-margin-amount /></label>`,
          add ? "Add margin" : "Remove margin",
        );
        onModalSubmit(panel, (status) => {
          const amount = Number(panel.querySelector<HTMLInputElement>("[data-margin-amount]")!.value);
          if (!(amount > 0)) {
            say(status, "Enter an amount greater than 0.", "error");
            return Promise.resolve(false);
          }
          return runWrite(
            status,
            "Updating margin…",
            () => updateIsolatedMargin(exchange, market.assetId, position.size > 0, add ? amount : -amount),
            "Margin updated.",
          );
        });
      }

      function openUsdModal(kind: "withdraw" | "transfer") {
        const exchange = getExchange();
        if (!exchange || !trader) return;
        const account = trader.address;
        const panel = modalForm(
          kind === "withdraw" ? "Withdraw USDC" : "Transfer USDC",
          `<label class="field"><span>Amount (USD)</span><input type="number" min="0" step="any" data-usd-amount /></label>
           ${
             kind === "withdraw"
               ? `<p class="quote-line">Withdraws to your own address only.</p>`
               : `<label class="field"><span>Direction</span><select data-usd-direction><option value="perp">Spot → Perp</option><option value="spot">Perp → Spot</option></select></label>`
           }`,
          kind === "withdraw" ? "Withdraw" : "Transfer",
        );
        onModalSubmit(panel, (status) => {
          const amount = Number(panel.querySelector<HTMLInputElement>("[data-usd-amount]")!.value);
          if (!(amount > 0)) {
            say(status, "Enter an amount greater than 0.", "error");
            return Promise.resolve(false);
          }
          if (kind === "withdraw") {
            return runWrite(status, "Withdrawing…", () => withdrawUsd(exchange, amount, account, [account]), "Withdrawal sent.");
          }
          const toPerp = panel.querySelector<HTMLSelectElement>("[data-usd-direction]")!.value === "perp";
          return runWrite(status, "Transferring…", () => moveUsd(exchange, amount, toPerp), "Transfer done.");
        });
      }

      async function submitTicket() {
        const exchange = getExchange();
        const market = selectedMarket;
        if (!exchange || !market) return;
        const price = Number(ticketPrice.value);
        const notional = Number(ticketNotional.value);
        const reduceOnly = ticketReduce.checked;
        if (!(price > 0) || !(notional > 0)) return say(ticketStatus, "Enter a price and notional.", "error");
        if (notional > maxOrderNotionalUsd) return say(ticketStatus, `Max $${maxOrderNotionalUsd} per order.`, "error");
        if (notional < minNotionalUsd && !reduceOnly) return say(ticketStatus, `Hyperliquid minimum is $${minNotionalUsd}.`, "error");
        ticketSubmit.disabled = true;
        await runWrite(
          ticketStatus,
          "Placing order…",
          async () => {
            if (market.kind === "perp" && !reduceOnly) {
              await setLeverage(exchange, market.assetId, Number(ticketLeverage.value), ticketMargin.value === "cross");
            }
            return placeLimitOrder(exchange, {
              assetId: market.assetId,
              isBuy: ticketSide === "buy",
              price,
              size: notional / price,
              szDecimals: market.szDecimals,
              kind: market.kind,
              tif: ticketTif.value as HlTif,
              reduceOnly,
              maxNotionalUsd: maxOrderNotionalUsd,
            });
          },
          "Order placed.",
        );
        ticketSubmit.disabled = false;
      }

      async function initTrade() {
        const exchange = getExchange();
        hlWalletNote.textContent = exchange
          ? "Trading on Hyperliquid testnet."
          : "Connect wallet to trade. Showing this address read-only on Hyperliquid testnet.";
        document.querySelectorAll<HTMLButtonElement>("[data-hl-action]").forEach((button) => {
          const action = button.dataset.hlAction;
          if (action === "deposit") return;
          if (action !== "swap") button.disabled = !exchange;
          button.addEventListener("click", () => {
            if (action === "swap") {
              const spot = tradeMarkets.find((m) => m.kind === "spot");
              if (spot) selectMarket(spot.coin);
              ticketPrice.scrollIntoView({ behavior: "smooth", block: "center" });
            } else {
              openUsdModal(action as "withdraw" | "transfer");
            }
          });
        });
        document.querySelector<HTMLButtonElement>("[data-hl-refresh]")!.addEventListener("click", () => void refreshDesk());
        const rangeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hl-range] [data-range]"));
        rangeButtons.forEach((button) =>
          button.addEventListener("click", () => {
            chartRange = button.dataset.range as ChartRangeKey;
            rangeButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            void renderHlChart();
          }),
        );
        const deskButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hl-desk-tabs] [data-desk]"));
        deskButtons.forEach((button) =>
          button.addEventListener("click", () => {
            deskTab = button.dataset.desk as typeof deskTab;
            deskButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            renderDesk();
          }),
        );
        const sideButtons = Array.from(ticket.querySelectorAll<HTMLButtonElement>("[data-side]"));
        sideButtons.forEach((button) =>
          button.addEventListener("click", () => {
            ticketSide = button.dataset.side as typeof ticketSide;
            sideButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
          }),
        );
        ticketPrice.addEventListener("input", renderTicket);
        ticketNotional.addEventListener("input", renderTicket);
        ticketSubmit.addEventListener("click", () => void submitTicket());
        renderTicket();

        void refreshDesk();
        try {
          tradeMarkets = (await loadTradeMarkets()).sort((a, b) => b.dayNtlVlm - a.dayNtlVlm);
          selectMarket(marketFor("BTC")?.coin ?? tradeMarkets[0].coin);
          renderDesk();
        } catch (error) {
          hlAssets.className = "error-text";
          hlAssets.textContent = errorText(error);
          hlTicker.className = "error-text";
          hlTicker.textContent = errorText(error);
        }
      }

      // ---- Account ----
      function initAccount() {
        if (!trader) return;
        const nameInput = document.querySelector<HTMLInputElement>("[data-profile-name]")!;
        const emailInput = document.querySelector<HTMLInputElement>("[data-profile-email]")!;
        const saveButton = document.querySelector<HTMLButtonElement>("[data-save-profile]")!;
        const shuffleButton = document.querySelector<HTMLButtonElement>("[data-shuffle]")!;
        const signOutButton = document.querySelector<HTMLButtonElement>("[data-sign-out]")!;
        const status = document.querySelector<HTMLElement>("[data-account-status]")!;

        const profileKey = "opencash.profile";
        type Profile = { name: string; email: string; variant?: number };
        let variant = 0;

        function loadProfile(): Profile | null {
          const raw = localStorage.getItem(profileKey);
          if (raw === null) return null;
          try {
            return JSON.parse(trader!.openProfile(JSON.parse(raw)));
          } catch {
            return null;
          }
        }
        function saveProfile(value: Profile) {
          localStorage.setItem(profileKey, JSON.stringify(trader!.sealProfile(JSON.stringify(value))));
        }

        async function paint() {
          const { avatarDataUri, avatarSeed, shortenAddress } = await avatars();
          const nameEl = document.querySelector<HTMLElement>("[data-account-name]");
          const emailEl = document.querySelector<HTMLElement>("[data-account-email]");
          const avatarEl = document.querySelector<HTMLImageElement>("[data-account-avatar]");
          const profile = loadProfile();
          variant = profile?.variant ?? 0;
          nameInput.value = profile?.name ?? "";
          emailInput.value = profile?.email ?? "";
          if (nameEl) nameEl.textContent = profile?.name || "Trader";
          if (emailEl) emailEl.textContent = profile?.email ?? "";
          if (avatarEl) {
            avatarEl.src = avatarDataUri(avatarSeed(trader!.address, variant));
            avatarEl.alt = `Avatar for ${shortenAddress(trader!.address)}`;
          }
        }
        void paint();

        saveButton.addEventListener("click", () => {
          saveProfile({ name: nameInput.value.trim(), email: emailInput.value.trim(), variant });
          status.textContent = "Saved on this device, encrypted with a key only your passkey derives.";
          void paint();
        });
        shuffleButton.addEventListener("click", () => {
          variant = (variant + 1) % 12;
          const profile = loadProfile();
          saveProfile({ name: profile?.name ?? "", email: profile?.email ?? "", variant });
          void paint();
        });
        signOutButton.addEventListener("click", disconnect);

        document.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async () => {
          if (!trader) return;
          await navigator.clipboard.writeText(trader.address);
          const hint = document.querySelector<HTMLElement>("[data-copy-hint]");
          if (hint) {
            hint.textContent = "Copied";
            setTimeout(() => (hint.textContent = "Copy"), 1400);
          }
        });
      }
    </script>
  </body>
</html>
