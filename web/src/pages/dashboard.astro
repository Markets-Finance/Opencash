---
import { isDevAuth } from "shared";
import AccountCard from "../components/AccountCard.astro";
import Mark from "../components/Mark.astro";
import "../styles/landing.css";
import "../styles/system.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard · OpenCash</title>
  </head>
  <body>
    <div class="gate" data-gate>
      {isDevAuth && (
        <p class="gate__dev">
          DEV MODE — no passkey. This is a shared test account, not yours.
        </p>
      )}
      <a class="wordmark gate__wordmark" href="/"><Mark />open<span>cash</span></a>
      <h1 class="gate__title">Sign in to trade</h1>
      <p class="gate__lede">
        One passkey derives your address. No seed phrase, no password, nothing
        stored on this device.
      </p>
      <div class="gate__actions">
        <button type="button" data-sign-in class="btn btn--primary">
          Sign in with passkey
        </button>
        <button type="button" data-create class="btn">Create a new account</button>
        <form class="gate__form" data-create-form hidden>
          <label class="field">
            <span>Name</span>
            <input name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" placeholder="ada@example.com" />
          </label>
          <button type="submit" class="btn btn--primary">Create passkey</button>
        </form>
      </div>
      <p class="gate__status" data-gate-status role="status"></p>
    </div>

    <div class="dash" data-dash data-tab="home" hidden>
      <header class="dash__topbar">
        <a class="wordmark" href="/"><Mark />open<span>cash</span></a>
        <nav class="dash__tabs" data-tabs role="tablist" aria-label="Dashboard sections">
          <button data-tab="home" role="tab" aria-selected="true">Home</button>
          <button data-tab="bins" role="tab" aria-selected="false">Bins</button>
          <button data-tab="trade" role="tab" aria-selected="false">Trade</button>
          <button data-tab="account" role="tab" aria-selected="false">Account</button>
        </nav>
        <div class="dash__topbar-spacer"></div>
        <div class="dash__topbar-utility">
          <input
            type="search"
            class="dash__search"
            placeholder="Search a symbol…"
            data-global-search
            autocomplete="off"
          />
          <div class="dash__account-menu" data-account-menu>
            <button
              type="button"
              class="dash__address-chip"
              data-topbar-address
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span data-topbar-address-text>—</span>
            </button>
            <div class="dash__menu" role="menu" data-account-menu-list hidden>
              <button type="button" class="dash__menu-item" role="menuitem" data-disconnect>
                Disconnect
              </button>
            </div>
          </div>
        </div>
      </header>

      <main class="dash__content">
        <section class="panel" data-panel="home">
          <div class="home-grid">
            <div class="home-left">
              <div class="card card--balance">
                <div class="balance-head">
                  <span class="card__label">My Balance</span>
                  <span class="chain-badge">Hyperliquid Testnet</span>
                </div>
                <span class="stat-card__value stat-card__value--lg" data-home-balance>—</span>
                <div class="balance-meta">
                  <span data-home-updated>—</span>
                  <button type="button" class="link-btn" data-home-refresh>⟳ Refresh</button>
                </div>
                <div class="action-grid">
                  <button type="button" class="action-btn" data-goto="trade">Trade</button>
                  <button type="button" class="action-btn" data-goto="bins">Bins</button>
                </div>
              </div>

              <div class="card">
                <div class="section-row"><span class="panel__label">Top Assets</span></div>
                <div data-top-assets class="asset-list asset-list--loading">Loading…</div>
              </div>
            </div>

            <div class="home-right">
              <div class="ticker-row ticker-row--loading" data-ticker-row>Loading…</div>

              <div class="card card--chart">
                <div class="section-row">
                  <div>
                    <span class="card__label">Portfolio Value</span>
                    <div class="chart-value-row">
                      <span class="stat-card__value" data-portfolio-value>—</span>
                      <span class="chart-change" data-portfolio-change></span>
                    </div>
                  </div>
                  <div class="chip-row" data-portfolio-range>
                    <button type="button" class="chip chip--active" data-range="1d">1D</button>
                    <button type="button" class="chip" data-range="7d">7D</button>
                    <button type="button" class="chip" data-range="30d">1M</button>
                    <button type="button" class="chip" data-range="all">All</button>
                  </div>
                </div>
                <div data-portfolio-chart class="chart-area"></div>
              </div>

              <div>
                <h3 class="panel__subtitle">Positions</h3>
                <div data-home-positions-table class="table-wrap table-wrap--loading">Loading…</div>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="bins" hidden>
          <div data-bins-carousel class="carousel carousel--loading">Loading…</div>
        </section>

        <section class="panel" data-panel="trade" hidden>
          <div class="hl-trade">
            <div class="home-grid">
              <div class="home-left">
                <div class="card card--balance">
                  <div class="balance-head">
                    <span class="card__label">My Balance</span>
                    <span class="chain-badge">Hyperliquid Testnet</span>
                  </div>
                  <span class="stat-card__value stat-card__value--lg hl-mono" data-hl-balance>—</span>
                  <div class="balance-meta">
                    <span class="hl-mono" data-hl-updated>—</span>
                    <button type="button" class="link-btn" data-hl-refresh>⟳ Refresh</button>
                  </div>
                  <div class="action-grid">
                    <button type="button" class="action-btn" data-hl-action="deposit" disabled>Deposit</button>
                    <button type="button" class="action-btn" data-hl-action="withdraw">Withdraw</button>
                    <button type="button" class="action-btn" data-hl-action="swap">Swap</button>
                    <button type="button" class="action-btn" data-hl-action="transfer">Transfer</button>
                  </div>
                  <p class="hl-note" data-hl-wallet-note></p>
                </div>

                <div class="card">
                  <div class="section-row"><span class="panel__label">Top Assets</span></div>
                  <div data-hl-assets class="asset-list asset-list--loading">Loading…</div>
                </div>
              </div>

              <div class="home-right">
                <div class="ticker-row ticker-row--loading" data-hl-ticker>Loading…</div>

                <div class="card card--chart">
                  <div class="section-row">
                    <div>
                      <span class="card__label" data-hl-chart-label>—</span>
                      <div class="chart-value-row">
                        <span class="stat-card__value hl-mono" data-hl-chart-value>—</span>
                        <span class="chart-change" data-hl-chart-change></span>
                      </div>
                    </div>
                    <div class="chip-row" data-hl-range>
                      <button type="button" class="chip" data-range="1h">1H</button>
                      <button type="button" class="chip" data-range="4h">4H</button>
                      <button type="button" class="chip chip--active" data-range="1d">1D</button>
                      <button type="button" class="chip" data-range="1w">1W</button>
                      <button type="button" class="chip" data-range="1m">1M</button>
                    </div>
                  </div>
                  <div class="chart-area hl-chart" data-hl-chart></div>
                  <div class="hl-axis" data-hl-axis></div>
                </div>

                <div class="hl-desk">
                  <div class="card">
                    <div class="section-row">
                      <div class="chip-row" data-hl-desk-tabs>
                        <button type="button" class="chip chip--active" data-desk="positions">Positions</button>
                        <button type="button" class="chip" data-desk="orders">Open Orders</button>
                        <button type="button" class="chip" data-desk="fills">Fills</button>
                      </div>
                    </div>
                    <div data-hl-desk class="table-wrap table-wrap--loading">Loading…</div>
                    <p class="status-line" data-hl-desk-status></p>
                  </div>
                </div>
              </div>

              <aside class="hl-ticket-bar">
                <div class="card hl-ticket" data-hl-ticket>
                  <span class="card__label" data-hl-ticket-title>Order</span>
                  <div class="mode-row">
                    <button type="button" class="chip chip--active" data-side="buy">Buy / Long</button>
                    <button type="button" class="chip" data-side="sell">Sell / Short</button>
                  </div>
                  <label class="field"><span>Limit price</span><input type="number" min="0" step="any" data-ticket-price /></label>
                  <label class="field"><span>Notional (USD)</span><input type="number" min="10" step="any" value="10.2" data-ticket-notional /></label>
                  <div class="hl-ticket__row" data-ticket-perp>
                    <label class="field"><span>Leverage</span><input type="number" min="1" step="1" value="5" data-ticket-leverage /></label>
                    <label class="field"><span>Margin</span><select data-ticket-margin><option value="cross">Cross</option><option value="isolated">Isolated</option></select></label>
                  </div>
                  <div class="hl-ticket__row">
                    <label class="field"><span>Time in force</span><select data-ticket-tif><option value="Alo">Post-only</option><option value="Gtc">Gtc</option><option value="Ioc">Ioc</option></select></label>
                    <label class="hl-check"><input type="checkbox" data-ticket-reduce /> Reduce-only</label>
                  </div>
                  <p class="quote-line" data-ticket-size></p>
                  <button type="button" class="btn btn--primary" data-ticket-submit>Place order</button>
                  <p class="status-line" data-ticket-status></p>
                </div>
              </aside>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="account" hidden>
          <div class="account-layout">
            <div class="account-layout__card" data-card-slot><AccountCard tier="Trader" /></div>
            <div class="account-layout__actions">
              <div class="card">
                <label class="field">
                  <span>Name</span>
                  <input type="text" data-profile-name placeholder="Trader" />
                </label>
                <label class="field">
                  <span>Email</span>
                  <input type="email" data-profile-email placeholder="you@domain.com" />
                </label>
                <div class="btn-row">
                  <button type="button" class="btn btn--primary" data-save-profile>Save profile</button>
                  <button type="button" class="btn" data-shuffle>Shuffle avatar</button>
                </div>
              </div>
              <button type="button" class="btn btn--quiet" data-sign-out>Sign out</button>
              <p class="account-status" data-account-status role="status"></p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="modal-overlay" data-modal hidden>
      <div class="modal" data-modal-panel></div>
    </div>

    <style is:global>
      :root {
        --sp-xs: 6px;
        --sp-sm: 10px;
        --sp-md: 16px;
        --sp-lg: 24px;
        --sp-xl: 32px;
        --sp-2xl: 48px;
        --radius-sm: 12px;
        --radius-md: 16px;
        --radius-lg: 20px;
        --content-max: none;
      }

      .gate {
        min-height: 100vh;
        display: grid;
        justify-items: center;
        align-content: center;
        gap: var(--sp-md);
        padding: var(--sp-2xl) var(--gutter);
        text-align: center;
      }
      .gate__dev {
        padding: var(--sp-sm) var(--sp-md);
        border-radius: 4px;
        background: var(--accent);
        color: #fff;
        font-size: 11px;
        letter-spacing: 0.08em;
      }
      .gate__wordmark {
        font-size: 28px;
        font-weight: 650;
        letter-spacing: -0.04em;
      }
      .gate__wordmark svg {
        width: 24px;
        height: 24px;
        margin-right: 4px;
      }
      .gate__title {
        margin-top: var(--sp-xs);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 300;
        letter-spacing: -0.04em;
      }
      .gate__lede {
        max-width: 46ch;
        font-size: 14px;
        color: var(--muted);
      }
      .gate__actions {
        display: flex;
        flex-direction: column;
        gap: var(--sp-sm);
        width: min(360px, 100%);
        margin-top: var(--sp-sm);
      }
      .gate__form {
        display: flex;
        flex-direction: column;
        gap: var(--sp-sm);
        padding: var(--sp-md);
        border: 1px dashed var(--line);
        border-radius: var(--radius-md);
        text-align: left;
      }
      .gate__status {
        min-height: 20px;
        font-size: 13px;
        color: var(--muted);
      }
      .gate__status[data-tone="error"] {
        color: var(--down);
      }

      .btn {
        padding: 13px 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: transparent;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .btn:hover {
        border-color: var(--ink);
      }
      .btn--primary {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--on-accent);
      }
      .btn--primary:hover {
        background: var(--accent);
      }
      .btn--primary:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .btn--quiet {
        border-style: dashed;
        font-weight: 400;
        align-self: flex-start;
      }
      .btn-row {
        display: flex;
        gap: var(--sp-sm);
        flex-wrap: wrap;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .field span,
      .field__label {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .field input,
      .field textarea {
        padding: 11px 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--paper);
        font: inherit;
        font-size: 14px;
        color: var(--ink);
        resize: vertical;
        width: 100%;
      }
      .field input:focus-visible,
      .field textarea:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* ---- Shell ---- */
      .dash {
        --gutter: var(--sp-lg);
        min-height: 100vh;
      }
      .dash__topbar {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: var(--sp-xl);
        padding: var(--sp-md) var(--gutter);
        background: rgba(247, 246, 242, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .dash__topbar .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 20px;
        font-weight: 650;
        letter-spacing: -0.04em;
        flex-shrink: 0;
      }
      .dash__topbar .wordmark svg {
        width: 18px;
        height: 18px;
        margin-right: 2px;
      }
      .dash__tabs {
        display: flex;
        align-items: center;
        gap: var(--sp-lg);
      }
      .dash__tabs button {
        border: 0;
        background: transparent;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        color: var(--muted);
        padding: 6px 2px;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        white-space: nowrap;
      }
      .dash__tabs button:hover {
        color: var(--ink);
      }
      .dash__tabs button[aria-selected="true"] {
        color: var(--ink);
        border-bottom-color: var(--accent);
      }
      .dash__topbar-spacer {
        flex: 1;
      }
      .dash__topbar-utility {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
        flex-shrink: 0;
      }
      .dash__search {
        width: 200px;
        padding: 9px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        font: inherit;
        font-size: 13px;
      }
      .dash__address-chip {
        border: 0;
        background: var(--surface-hover);
        color: var(--ink);
        font-size: 12px;
        font-weight: 500;
        padding: 9px 14px;
        border-radius: 999px;
        cursor: pointer;
        white-space: nowrap;
      }
      .dash__address-chip:hover {
        background: var(--surface-line);
      }
      .dash__account-menu {
        position: relative;
      }
      .dash__menu {
        position: absolute;
        top: calc(100% + var(--sp-xs));
        right: 0;
        z-index: 20;
        min-width: 160px;
        padding: var(--sp-xs);
        border: 1px solid var(--surface-line);
        border-radius: var(--radius-sm);
        background: var(--paper);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
      }
      .dash__menu[hidden] {
        display: none;
      }
      .dash__menu-item {
        width: 100%;
        border: 0;
        background: transparent;
        color: var(--ink);
        font: inherit;
        font-size: 13px;
        text-align: left;
        padding: var(--sp-sm);
        border-radius: var(--radius-sm);
        cursor: pointer;
      }
      .dash__menu-item:hover,
      .dash__menu-item:focus-visible {
        background: var(--surface-hover);
      }
      .dash__content {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--sp-2xl) var(--gutter) 120px;
      }
      .panel__subtitle {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin: var(--sp-2xl) 0 var(--sp-md);
      }
      .panel__label {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .section-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--sp-md);
      }

      /* ---- Home ---- */
      .home-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: var(--sp-lg);
        align-items: start;
      }
      .home-left,
      .home-right {
        display: flex;
        flex-direction: column;
        gap: var(--sp-lg);
      }
      .card--balance {
        display: flex;
        flex-direction: column;
        gap: var(--sp-xs);
      }
      .balance-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .chain-badge {
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 999px;
        background: var(--surface-hover);
        color: var(--muted);
      }
      .stat-card__value--lg {
        font-size: 38px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      .balance-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: var(--muted);
        margin-bottom: var(--sp-xs);
      }
      .action-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--sp-sm);
        margin-top: var(--sp-sm);
      }
      .action-btn {
        padding: 12px 8px;
        border-radius: var(--radius-sm);
        background: var(--surface-hover);
        border: 0;
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        text-align: center;
      }
      .action-btn:hover {
        background: var(--surface-line);
      }

      .asset-list {
        display: flex;
        flex-direction: column;
      }
      .asset-list--loading {
        font-size: 13px;
        color: var(--muted);
      }
      .asset-row {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
        padding: var(--sp-sm) 0;
        border-top: 1px solid var(--line);
      }
      .asset-row:first-child {
        border-top: 0;
      }
      .asset-row__identity {
        flex: 1;
        min-width: 0;
        font-size: 13px;
        font-weight: 600;
      }
      .asset-row__price {
        font-size: 13px;
        font-weight: 500;
        text-align: right;
      }
      .asset-row__change {
        font-size: 11px;
        text-align: right;
        min-width: 56px;
      }
      .change-up {
        color: var(--up);
      }
      .change-down {
        color: var(--down);
      }

      .ticker-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--sp-md);
      }
      .ticker-row--loading {
        display: block;
        padding: var(--sp-lg);
        font-size: 13px;
        color: var(--muted);
        background: var(--surface);
        border-radius: var(--radius-md);
      }
      .ticker-card {
        background: var(--surface);
        border-radius: var(--radius-md);
        padding: var(--sp-md);
      }
      .ticker-card__head {
        display: flex;
        align-items: center;
        gap: var(--sp-xs);
      }
      .ticker-card__head .row-mark {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        font-size: 10px;
      }
      .ticker-card__symbol {
        font-size: 12px;
        color: var(--muted);
      }
      .ticker-card__price {
        font-size: 20px;
        font-weight: 600;
        margin-top: 4px;
      }
      .ticker-card__change {
        font-size: 12px;
        margin-top: 2px;
      }

      .chart-value-row {
        display: flex;
        align-items: baseline;
        gap: var(--sp-sm);
        margin-top: 4px;
      }
      .chart-change {
        font-size: 13px;
        font-weight: 500;
      }
      .chart-area {
        margin-top: var(--sp-md);
        height: 220px;
      }
      .chart-area svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      .chart-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
        color: var(--muted);
        font-size: 13px;
        text-align: center;
        padding: 0 var(--sp-xl);
      }

      .stat-card__value {
        font-size: 32px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      /* ---- Dark theme ---- */
      .dash,
      .modal {
        background: var(--paper);
        color: var(--ink);
      }
      .dash .dash__topbar {
        background: rgba(11, 15, 14, 0.92);
      }
      .dash .dash__topbar .wordmark,
      .dash .dash__tabs button {
        color: #9aa39f;
      }
      .dash .dash__tabs button[aria-selected="true"],
      .dash .dash__tabs button:hover {
        color: var(--ink);
      }
      .dash .dash__search {
        color: var(--ink);
      }
      .dash .dash__address-chip {
        background: var(--surface-hover);
