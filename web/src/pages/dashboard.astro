---
import { isDevAuth } from "shared";
import AccountCard from "../components/AccountCard.astro";
import Mark from "../components/Mark.astro";
import "../styles/landing.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard · OpenCash</title>
  </head>
  <body>
    <div class="gate" data-gate>
      {isDevAuth && (
        <p class="gate__dev">
          DEV MODE — no passkey. This is a shared test account, not yours.
        </p>
      )}
      <a class="wordmark gate__wordmark" href="/"><Mark />open<span>cash</span></a>
      <h1 class="gate__title">Sign in to trade</h1>
      <p class="gate__lede">
        One passkey derives your address. No seed phrase, no password, nothing
        stored on this device.
      </p>
      <div class="gate__actions">
        <button type="button" data-sign-in class="btn btn--primary">
          Sign in with passkey
        </button>
        <button type="button" data-create class="btn">Create a new account</button>
        <form class="gate__form" data-create-form hidden>
          <label class="field">
            <span>Name</span>
            <input name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" placeholder="ada@example.com" />
          </label>
          <button type="submit" class="btn btn--primary">Create passkey</button>
        </form>
      </div>
      <p class="gate__status" data-gate-status role="status"></p>
    </div>

    <div class="dash" data-dash hidden>
      <header class="dash__topbar">
        <a class="wordmark" href="/"><Mark />open<span>cash</span></a>
        <nav class="dash__tabs" data-tabs role="tablist" aria-label="Dashboard sections">
          <button data-tab="home" role="tab" aria-selected="true">Home</button>
          <button data-tab="bins" role="tab" aria-selected="false">Bins</button>
          <button data-tab="trade" role="tab" aria-selected="false">Trade</button>
          <button data-tab="account" role="tab" aria-selected="false">Account</button>
        </nav>
        <div class="dash__topbar-spacer"></div>
        <div class="dash__topbar-utility">
          <input
            type="search"
            class="dash__search"
            placeholder="Search a symbol…"
            data-global-search
            autocomplete="off"
          />
          <button type="button" class="dash__address-chip" data-topbar-address>
            <span data-topbar-address-text>—</span>
          </button>
        </div>
      </header>

      <main class="dash__content">
        <section class="panel" data-panel="home">
          <div class="home-grid">
            <div class="home-left">
              <div class="card card--balance">
                <div class="balance-head">
                  <span class="card__label">My Balance</span>
                  <span class="chain-badge">Robinhood Chain</span>
                </div>
                <span class="stat-card__value stat-card__value--lg" data-home-balance>—</span>
                <div class="balance-meta">
                  <span data-home-updated>—</span>
                  <button type="button" class="link-btn" data-home-refresh>⟳ Refresh</button>
                </div>
                <div class="action-grid">
                  <button type="button" class="action-btn" data-goto="trade">Trade</button>
                  <button type="button" class="action-btn" data-goto="bins">Bins</button>
                </div>
              </div>

              <div class="card">
                <div class="section-row"><span class="panel__label">Top Assets</span></div>
                <div data-top-assets class="asset-list asset-list--loading">Loading…</div>
              </div>
            </div>

            <div class="home-right">
              <div class="ticker-row ticker-row--loading" data-ticker-row>Loading…</div>

              <div class="card card--chart">
                <div class="section-row">
                  <div>
                    <span class="card__label">Portfolio Value</span>
                    <div class="chart-value-row">
                      <span class="stat-card__value" data-portfolio-value>—</span>
                      <span class="chart-change" data-portfolio-change></span>
                    </div>
                  </div>
                  <div class="chip-row" data-portfolio-range>
                    <button type="button" class="chip chip--active" data-range="1d">1D</button>
                    <button type="button" class="chip" data-range="7d">7D</button>
                    <button type="button" class="chip" data-range="30d">1M</button>
                    <button type="button" class="chip" data-range="all">All</button>
                  </div>
                </div>
                <div data-portfolio-chart class="chart-area"></div>
              </div>

              <div>
                <h3 class="panel__subtitle">Positions</h3>
                <div data-home-positions-table class="table-wrap table-wrap--loading">Loading…</div>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="bins" hidden>
          <div data-bins-carousel class="carousel carousel--loading">Loading…</div>
        </section>

        <section class="panel" data-panel="trade" hidden>
          <div data-trade-list-view>
            <div class="toolbar">
              <input
                type="search"
                class="search-input"
                placeholder="Search symbol or name"
                data-trade-search
                autocomplete="off"
              />
              <div class="chip-row" data-trade-category>
                <button type="button" class="chip chip--active" data-category="all">All</button>
                <button type="button" class="chip" data-category="held">Held</button>
              </div>
            </div>
            <div data-trade-list class="table-wrap table-wrap--loading">Loading…</div>
          </div>

          <div data-asset-view hidden>
            <button type="button" class="link-btn" data-asset-back>← Back to search</button>
            <div class="asset-layout">
              <div class="asset-main">
                <div class="asset-header" data-asset-header></div>
                <div class="asset-price-row">
                  <span class="asset-price-value" data-asset-price>—</span>
                  <span class="asset-price-change" data-asset-change></span>
                </div>
                <div class="chip-row" data-asset-range>
                  <button type="button" class="chip chip--active" data-range="5d">5D</button>
                  <button type="button" class="chip" data-range="1mo">1M</button>
                  <button type="button" class="chip" data-range="3mo">3M</button>
                  <button type="button" class="chip" data-range="1y">1Y</button>
                </div>
                <div class="chart-area" data-asset-chart></div>
                <div class="asset-stats-row" data-asset-stats></div>
              </div>
              <div class="asset-side">
                <div class="card card--trade-panel">
                  <p class="quote-line" data-asset-holding></p>
                  <div class="mode-row">
                    <button type="button" class="chip chip--active" data-mode="buy">Buy</button>
                    <button type="button" class="chip" data-mode="sell">Sell</button>
                  </div>
                  <div data-asset-mode-body></div>
                  <p class="status-line" data-asset-status></p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="account" hidden>
          <div class="account-layout">
            <div class="account-layout__card" data-card-slot><AccountCard tier="Trader" /></div>
            <div class="account-layout__actions">
              <div class="card">
                <label class="field">
                  <span>Name</span>
                  <input type="text" data-profile-name placeholder="Trader" />
                </label>
                <label class="field">
                  <span>Email</span>
                  <input type="email" data-profile-email placeholder="you@domain.com" />
                </label>
                <div class="btn-row">
                  <button type="button" class="btn btn--primary" data-save-profile>Save profile</button>
                  <button type="button" class="btn" data-shuffle>Shuffle avatar</button>
                </div>
              </div>
              <button type="button" class="btn btn--quiet" data-sign-out>Sign out</button>
              <p class="account-status" data-account-status role="status"></p>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="modal-overlay" data-modal hidden>
      <div class="modal" data-modal-panel></div>
    </div>

    <style is:global>
      :root {
        --sp-xs: 6px;
        --sp-sm: 10px;
        --sp-md: 16px;
        --sp-lg: 24px;
        --sp-xl: 32px;
        --sp-2xl: 48px;
        --radius-sm: 12px;
        --radius-md: 16px;
        --radius-lg: 20px;
        --content-max: 1320px;
        --surface: #f0efe9;
        --surface-hover: #e8e6df;
        --surface-line: #e2e0d9;
      }

      .gate {
        min-height: 100vh;
        display: grid;
        justify-items: center;
        align-content: center;
        gap: var(--sp-md);
        padding: var(--sp-2xl) var(--gutter);
        text-align: center;
      }
      .gate__dev {
        padding: var(--sp-sm) var(--sp-md);
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11px;
        letter-spacing: 0.08em;
      }
      .gate__wordmark {
        font-size: 28px;
        font-weight: 650;
        letter-spacing: -0.04em;
      }
      .gate__wordmark svg {
        width: 24px;
        height: 24px;
        margin-right: 4px;
      }
      .gate__title {
        margin-top: var(--sp-xs);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 300;
        letter-spacing: -0.04em;
      }
      .gate__lede {
        max-width: 46ch;
        font-size: 14px;
        color: #5c5c5f;
      }
      .gate__actions {
        display: flex;
        flex-direction: column;
        gap: var(--sp-sm);
        width: min(360px, 100%);
        margin-top: var(--sp-sm);
      }
      .gate__form {
        display: flex;
        flex-direction: column;
        gap: var(--sp-sm);
        padding: var(--sp-md);
        border: 1px dashed var(--line);
        border-radius: var(--radius-md);
        text-align: left;
      }
      .gate__status {
        min-height: 20px;
        font-size: 13px;
        color: #5c5c5f;
      }
      .gate__status[data-tone="error"] {
        color: #b4443a;
      }

      .btn {
        padding: 13px 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: transparent;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .btn:hover {
        border-color: var(--ink);
      }
      .btn--primary {
        border-color: var(--purple);
        background: var(--purple);
        color: var(--paper);
      }
      .btn--primary:hover {
        background: #5f52e4;
      }
      .btn--primary:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .btn--quiet {
        border-style: dashed;
        font-weight: 400;
        align-self: flex-start;
      }
      .btn-row {
        display: flex;
        gap: var(--sp-sm);
        flex-wrap: wrap;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .field span,
      .field__label {
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #5c5c5f;
      }
      .field input,
      .field textarea {
        padding: 11px 14px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--paper);
        font: inherit;
        font-size: 14px;
        color: var(--ink);
        resize: vertical;
        width: 100%;
      }
      .field input:focus-visible,
      .field textarea:focus-visible {
        outline: 2px solid var(--purple);
        outline-offset: 2px;
      }

      /* ---- Shell ---- */
      .dash {
        min-height: 100vh;
      }
      .dash__topbar {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: var(--sp-xl);
        padding: var(--sp-md) var(--gutter);
        background: rgba(247, 246, 242, 0.92);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .dash__topbar .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 20px;
        font-weight: 650;
        letter-spacing: -0.04em;
        flex-shrink: 0;
      }
      .dash__topbar .wordmark svg {
        width: 18px;
        height: 18px;
        margin-right: 2px;
      }
      .dash__tabs {
        display: flex;
        align-items: center;
        gap: var(--sp-lg);
      }
      .dash__tabs button {
        border: 0;
        background: transparent;
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        color: #5c5c5f;
        padding: 6px 2px;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        white-space: nowrap;
      }
      .dash__tabs button:hover {
        color: var(--ink);
      }
      .dash__tabs button[aria-selected="true"] {
        color: var(--ink);
        border-bottom-color: var(--purple);
      }
      .dash__topbar-spacer {
        flex: 1;
      }
      .dash__topbar-utility {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
        flex-shrink: 0;
      }
      .dash__search {
        width: 200px;
        padding: 9px 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        font: inherit;
        font-size: 13px;
      }
      .dash__address-chip {
        border: 0;
        background: #ece9e3;
        color: var(--ink);
        font-size: 12px;
        font-weight: 500;
        padding: 9px 14px;
        border-radius: 999px;
        cursor: pointer;
        white-space: nowrap;
      }
      .dash__address-chip:hover {
        background: #e0ddd5;
      }
      .dash__content {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--sp-2xl) var(--gutter) 120px;
      }
      .panel__subtitle {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #858589;
        margin: var(--sp-2xl) 0 var(--sp-md);
      }
      .panel__label {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #858589;
      }
      .section-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--sp-md);
      }

      /* ---- Home ---- */
      .home-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: var(--sp-lg);
        align-items: start;
      }
      .home-left,
      .home-right {
        display: flex;
        flex-direction: column;
        gap: var(--sp-lg);
      }
      .card--balance {
        display: flex;
        flex-direction: column;
        gap: var(--sp-xs);
      }
      .balance-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .chain-badge {
        font-size: 11px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #ece9e3;
        color: #5c5c5f;
      }
      .stat-card__value--lg {
        font-size: 38px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      .balance-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: #858589;
        margin-bottom: var(--sp-xs);
      }
      .action-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--sp-sm);
        margin-top: var(--sp-sm);
      }
      .action-btn {
        padding: 12px 8px;
        border-radius: var(--radius-sm);
        background: #ece9e3;
        border: 0;
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        text-align: center;
      }
      .action-btn:hover {
        background: #e0ddd5;
      }

      .asset-list {
        display: flex;
        flex-direction: column;
      }
      .asset-list--loading {
        font-size: 13px;
        color: #858589;
      }
      .asset-row {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
        padding: var(--sp-sm) 0;
        border-top: 1px solid var(--line);
      }
      .asset-row:first-child {
        border-top: 0;
      }
      .asset-row__identity {
        flex: 1;
        min-width: 0;
        font-size: 13px;
        font-weight: 600;
      }
      .asset-row__price {
        font-size: 13px;
        font-weight: 500;
        text-align: right;
      }
      .asset-row__change {
        font-size: 11px;
        text-align: right;
        min-width: 56px;
      }
      .change-up {
        color: #1f8a4c;
      }
      .change-down {
        color: #c0392b;
      }

      .ticker-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--sp-md);
      }
      .ticker-row--loading {
        display: block;
        padding: var(--sp-lg);
        font-size: 13px;
        color: #858589;
        background: var(--surface);
        border-radius: var(--radius-md);
      }
      .ticker-card {
        background: var(--surface);
        border-radius: var(--radius-md);
        padding: var(--sp-md);
      }
      .ticker-card__head {
        display: flex;
        align-items: center;
        gap: var(--sp-xs);
      }
      .ticker-card__head .row-mark {
        width: 22px;
        height: 22px;
        border-radius: 7px;
        font-size: 10px;
      }
      .ticker-card__symbol {
        font-size: 12px;
        color: #858589;
      }
      .ticker-card__price {
        font-size: 20px;
        font-weight: 600;
        margin-top: 4px;
      }
      .ticker-card__change {
        font-size: 12px;
        margin-top: 2px;
      }

      .chart-value-row {
        display: flex;
        align-items: baseline;
        gap: var(--sp-sm);
        margin-top: 4px;
      }
      .chart-change {
        font-size: 13px;
        font-weight: 500;
      }
      .chart-area {
        margin-top: var(--sp-md);
        height: 220px;
      }
      .chart-area svg {
        width: 100%;
        height: 100%;
        display: block;
      }
      .chart-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 220px;
        color: #858589;
        font-size: 13px;
        text-align: center;
        padding: 0 var(--sp-xl);
      }

      /* ---- Single-asset trading view (Trade tab) ---- */
      .asset-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: var(--sp-xl);
        align-items: start;
        margin-top: var(--sp-md);
      }
      .asset-header {
        margin-bottom: var(--sp-md);
      }
      .asset-header .modal__identity .row-mark {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        font-size: 16px;
      }
      .asset-price-row {
        display: flex;
        align-items: baseline;
        gap: var(--sp-sm);
        margin-bottom: var(--sp-md);
      }
      .asset-price-value {
        font-size: 38px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      .asset-price-change {
        font-size: 15px;
        font-weight: 500;
      }
      .asset-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--sp-md);
        margin-top: var(--sp-lg);
      }
      .asset-side {
        display: flex;
        flex-direction: column;
        gap: var(--sp-md);
      }
      .card--trade-panel {
        position: sticky;
        top: 100px;
      }

      .stat-card {
        border-radius: var(--radius-md);
        background: var(--surface);
        padding: var(--sp-lg);
        display: flex;
        flex-direction: column;
        gap: var(--sp-xs);
      }
      .stat-card__label {
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #858589;
      }
      .stat-card__value {
        font-size: 32px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      /* ---- Generic cards ---- */
      .card {
        border-radius: var(--radius-md);
        background: var(--surface);
        padding: var(--sp-lg);
      }
      .card + .card {
        margin-top: var(--sp-md);
      }
      .card__title {
        font-size: 16px;
        font-weight: 600;
        margin-top: var(--sp-sm);
      }
      .card__body {
        font-size: 13px;
        line-height: 1.6;
        color: #6a686b;
        margin-top: var(--sp-xs);
      }

      /* ---- Carousels (Bins) ---- */
      .carousel {
        display: flex;
        gap: var(--sp-md);
        overflow-x: auto;
        scroll-snap-type: x proximity;
        padding-bottom: var(--sp-sm);
        scrollbar-width: thin;
      }
      .carousel--loading,
      .table-wrap--loading {
        padding: var(--sp-xl);
        font-size: 13px;
        color: #858589;
        background: var(--surface);
        border-radius: var(--radius-md);
      }
      .tile-card {
        scroll-snap-align: start;
        flex: 0 0 280px;
        text-align: left;
        border-radius: var(--radius-md);
        background: var(--surface);
        padding: var(--sp-lg);
        border: 0;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: var(--sp-sm);
      }
      .tile-card:hover {
        outline: 2px solid var(--purple);
        outline-offset: -2px;
      }
      .tile-card__name {
        font-size: 16px;
        font-weight: 600;
      }
      .tile-card__value {
        font-size: 22px;
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .tile-card__thesis {
        font-size: 12px;
        color: #6a686b;
        line-height: 1.5;
      }
      .tile-card__legs {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-top: var(--sp-xs);
      }
      .tile-leg {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #79797d;
      }

      /* ---- Table (Trade) ---- */
      .toolbar {
        display: flex;
        align-items: center;
        gap: var(--sp-md);
        margin-bottom: var(--sp-lg);
      }
      .search-input {
        flex: 1;
        padding: 12px var(--sp-md);
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--paper);
        font: inherit;
        font-size: 14px;
      }
      .table-wrap {
        border-radius: var(--radius-md);
        background: var(--surface);
        overflow: hidden;
      }
      .data-table {
        width: 100%;
        border-collapse: collapse;
      }
      .data-table thead th {
        text-align: left;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #858589;
        padding: var(--sp-md) var(--sp-lg);
        border-bottom: 1px solid var(--line);
      }
      .data-table tbody tr {
        cursor: pointer;
        border-bottom: 1px solid var(--surface-line);
      }
      .data-table tbody tr:last-child {
        border-bottom: 0;
      }
      .data-table tbody tr:hover {
        background: var(--surface-hover);
      }
      .data-table tbody td {
        padding: var(--sp-md) var(--sp-lg);
        font-size: 14px;
      }
      .cell-identity {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
        font-weight: 600;
      }
      .cell-muted {
        color: #858589;
      }
      .cell-value {
        text-align: right;
        font-weight: 500;
        white-space: nowrap;
      }

      .row-mark {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: #dedbd2;
        display: grid;
        place-items: center;
        font-size: 13px;
        font-weight: 600;
        flex-shrink: 0;
        overflow: hidden;
      }
      .row-mark--logo {
        background: #fff;
        border: 1px solid var(--surface-line);
      }
      .row-mark img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .leg-stack {
        display: flex;
        align-items: center;
      }
      .leg-stack .row-mark {
        width: 26px;
        height: 26px;
        border-radius: 999px;
        border: 2px solid var(--paper);
        margin-left: -8px;
        font-size: 10px;
      }
      .leg-stack .row-mark:first-child {
        margin-left: 0;
      }

      .empty,
      .error-text {
        padding: var(--sp-xl);
        font-size: 13px;
        text-align: center;
        background: var(--surface);
        border-radius: var(--radius-md);
      }
      .error-text {
        color: #a5382a;
      }

      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-xs);
      }
      .chip {
        border-radius: 999px;
        padding: 9px 16px;
        background: #ece9e3;
        border: 0;
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        color: var(--ink);
        cursor: pointer;
        white-space: nowrap;
      }
      .chip--active {
        background: var(--ink);
        color: var(--paper);
      }
      .mode-row {
        display: flex;
        gap: var(--sp-xs);
        margin-bottom: var(--sp-md);
      }
      .mode-row .chip {
        flex: 1;
        text-align: center;
      }

      /* ---- Modal (Bin / Trade / Mandate detail + New mandate) ---- */
      .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--sp-lg);
        background: rgba(20, 19, 24, 0.45);
        backdrop-filter: blur(2px);
      }
      .modal-overlay[hidden] {
        display: none;
      }
      .modal {
        width: min(520px, 100%);
        max-height: 86vh;
        overflow-y: auto;
        background: var(--paper);
        border-radius: var(--radius-lg);
        padding: var(--sp-xl);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
      }
      .modal__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--sp-md);
      }
      .modal__identity {
        display: flex;
        align-items: center;
        gap: var(--sp-sm);
      }
      .modal__title {
        font-size: 19px;
        font-weight: 600;
      }
      .modal__close {
        background: none;
        border: 0;
        font-size: 20px;
        color: #858589;
        cursor: pointer;
        line-height: 1;
        padding: var(--sp-xs);
      }

      .amount-row {
        display: flex;
        align-items: baseline;
        gap: var(--sp-xs);
        margin: var(--sp-sm) 0;
      }
      .amount-row input {
        flex: 1;
        border: 0;
        background: transparent;
        font-size: 34px;
        font-weight: 300;
        letter-spacing: -0.03em;
        color: var(--ink);
        padding: 0;
      }
      .amount-row input:focus-visible {
        outline: none;
      }
      .quote-line {
        font-size: 13px;
        color: #6a686b;
        margin: var(--sp-xs) 0;
      }
      .warn-line {
        font-size: 12px;
        color: #a5382a;
        margin: var(--sp-sm) 0;
      }
      .status-line {
        font-size: 13px;
        color: #6a686b;
        margin-top: var(--sp-sm);
      }
      .status-line[data-tone="error"] {
        color: #a5382a;
      }
      .form-error {
        font-size: 12px;
        color: #a5382a;
        min-height: 14px;
      }

      .leg-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        padding: var(--sp-xs) 0;
        border-top: 1px solid var(--line);
      }
      .leg-row:first-child {
        border-top: 0;
      }

      .receipt-row {
        padding: var(--sp-sm) 0;
        border-top: 1px solid var(--line);
        font-size: 12px;
      }
      .receipt-row:first-child {
        border-top: 0;
      }
      .receipt-row__status {
        font-weight: 600;
        text-transform: capitalize;
      }
      .receipt-row__detail {
        color: #6a686b;
        margin-top: 2px;
      }

      /* ---- Account tab ---- */
      .account-layout {
        display: flex;
        gap: var(--sp-2xl);
        align-items: flex-start;
        flex-wrap: wrap;
      }
      .account-layout__card {
        flex: 0 0 340px;
        max-width: 100%;
      }
      .account-layout__actions {
        flex: 1 1 320px;
        display: flex;
        flex-direction: column;
        gap: var(--sp-md);
        max-width: 420px;
      }
      .account-status {
        min-height: 20px;
        font-size: 13px;
        color: #5c5c5f;
      }

      @media (max-width: 960px) {
        .dash__topbar {
          flex-wrap: wrap;
          gap: var(--sp-sm);
        }
        .dash__tabs {
          order: 3;
          width: 100%;
          overflow-x: auto;
        }
        .dash__topbar-spacer {
          display: none;
        }
        .dash__search {
          width: 140px;
        }
        .home-grid,
        .ticker-row,
        .action-grid,
        .asset-layout,
        .asset-stats-row {
          grid-template-columns: 1fr;
        }
        .card--trade-panel {
          position: static;
        }
        .ticker-row {
          grid-template-columns: repeat(2, 1fr);
        }
        .toolbar {
          flex-direction: column;
          align-items: stretch;
        }
        .account-layout__card {
          flex-basis: 100%;
          max-width: 340px;
        }
      }
    </style>

    <script>
      import { isMeraError } from "@category-labs/mera";
      import { stockLogoUrl, type BinPosition, type TradingAccount } from "shared";
      import { createAccount, signIn } from "../scripts/mera";
      import { loadAssetRegistry } from "../scripts/assets";
      import {
        bins,
        buyToken,
        checkTradable,
        loadPositions,
        loadTokenHolding,
        loadTokens,
        loadTradeAssets,
        loadUsdgBalance,
        openBin,
        quoteSell,
        quoteTrade,
        sellToken,
        sizeBinFor,
        sizeProposal,
        type Bin,
        type EntryStep,
        type HoodData,
        type TradeAsset,
      } from "../scripts/hood";
      import {
        fetchMarketChart,
        fetchMarketCharts,
        fetchPortfolioHistory,
        fetchTradableSymbols,
        snapshotPortfolio,
        type ChartRange,
        type PortfolioSnapshot,
      } from "../scripts/backend";

      type AvatarModule = typeof import("../lib/avatar");
      let avatarModule: AvatarModule | null = null;
      async function avatars(): Promise<AvatarModule> {
        avatarModule ??= await import("../lib/avatar");
        return avatarModule;
      }

      const stepLabels: Record<EntryStep, string> = {
        approve: "Approving USDG…",
        swap: "Swapping…",
      };

      function usd(value: number): string {
        return `$${value.toLocaleString(undefined, { maximumFractionDigits: 2 })}`;
      }
      function initial(text: string): string {
        return text.slice(0, 1).toUpperCase();
      }

      // Real logo when the registry has one (Robinhood's own CDN, no CORS
      // issue for <img>), falling back to the letter mark on a missing URL
      // or a broken image load. The fallback is a hidden sibling toggled by
      // onerror rather than a reconstructed HTML string — simpler, and it
      // can't be broken by quote/entity escaping.
      function markHtml(logoUrl: string | undefined, label: string): string {
        const letter = initial(label);
        if (!logoUrl) return `<span class="row-mark">${letter}</span>`;
        return `<span class="row-mark row-mark--logo"><img src="${logoUrl}" alt="" loading="lazy" onerror="this.remove();this.nextElementSibling.hidden=false" /><span hidden>${letter}</span></span>`;
      }

      // Looks the logo up in the centralized registry (assets.ts) by
      // symbol — callers never need to fetch or thread a token map just to
      // render a mark.
      function markForSymbol(symbol: string): string {
        return markHtml(stockLogoUrl(symbol), symbol);
      }

      function legStackHtml(symbols: string[]): string {
        return `<div class="leg-stack">${symbols.slice(0, 4).map(markForSymbol).join("")}</div>`;
      }

      // ---- Modal ----
      const modalOverlay = document.querySelector<HTMLElement>("[data-modal]")!;
      const modalPanel = document.querySelector<HTMLElement>("[data-modal-panel]")!;
      function openModal(html: string): HTMLElement {
        modalPanel.innerHTML = html;
        modalOverlay.hidden = false;
        modalPanel.querySelector<HTMLButtonElement>("[data-close]")?.addEventListener("click", closeModal);
        return modalPanel;
      }
      function closeModal() {
        modalOverlay.hidden = true;
        modalPanel.innerHTML = "";
      }
      modalOverlay.addEventListener("click", (event) => {
        if (event.target === modalOverlay) closeModal();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modalOverlay.hidden) closeModal();
      });

      // ---- Gate (sign-in) ----
      const gate = document.querySelector<HTMLElement>("[data-gate]")!;
      const dash = document.querySelector<HTMLElement>("[data-dash]")!;
      const gateStatus = document.querySelector<HTMLElement>("[data-gate-status]")!;
      const gateSignIn = document.querySelector<HTMLButtonElement>("[data-sign-in]")!;
      const gateCreate = document.querySelector<HTMLButtonElement>("[data-create]")!;
      const gateCreateForm = document.querySelector<HTMLFormElement>("[data-create-form]")!;

      let trader: TradingAccount | null = null;

      function sayGate(message: string, tone: "info" | "error" = "info") {
        gateStatus.textContent = message;
        gateStatus.dataset.tone = tone;
      }

      function explain(error: unknown): string {
        if (!isMeraError(error)) {
          return error instanceof Error ? error.message : "Something went wrong.";
        }
        const messages: Record<string, string> = {
          PRF_UNAVAILABLE:
            "This passkey cannot derive keys. Try a passkey stored in iCloud Keychain, Google Password Manager or 1Password.",
          PASSKEY_OPERATION_FAILED: "The passkey prompt was cancelled or unavailable.",
          CRYPTO_UNAVAILABLE: "This browser is missing a required crypto primitive.",
        };
        return messages[error.code] ?? `${error.code}: ${error.message}`;
      }

      async function enterDashboard(account: TradingAccount) {
        trader = account;
        gate.hidden = true;
        dash.hidden = false;
        void loadAssetRegistry();

        const { avatarDataUri, avatarSeed, shortenAddress } = await avatars();
        const nameEl = document.querySelector<HTMLElement>("[data-account-name]");
        const addressEl = document.querySelector<HTMLElement>("[data-address-text]");
        const avatarEl = document.querySelector<HTMLImageElement>("[data-account-avatar]");
        const topbarAddressEl = document.querySelector<HTMLElement>("[data-topbar-address-text]");
        if (nameEl) nameEl.textContent = "Trader";
        if (addressEl) addressEl.textContent = shortenAddress(account.address);
        if (topbarAddressEl) topbarAddressEl.textContent = shortenAddress(account.address);
        if (avatarEl) {
          avatarEl.src = avatarDataUri(avatarSeed(account.address, 0));
          avatarEl.alt = `Avatar for ${shortenAddress(account.address)}`;
        }

        initHome();
      }

      async function run(action: () => Promise<TradingAccount>, pending: string) {
        sayGate(pending);
        try {
          await enterDashboard(await action());
        } catch (error) {
          sayGate(explain(error), "error");
        }
      }

      gateSignIn.addEventListener("click", () => run(signIn, "Waiting for your passkey…"));
      gateCreate.addEventListener("click", () => {
        gateCreateForm.hidden = !gateCreateForm.hidden;
        if (!gateCreateForm.hidden) gateCreateForm.querySelector("input")?.focus();
      });
      gateCreateForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(gateCreateForm);
        const name = String(data.get("name") ?? "").trim();
        const email = String(data.get("email") ?? "").trim();
        void run(() => createAccount(email, name), "Creating a passkey…");
      });

      // ---- Tabs ----
      const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
      const panels = new Map(
        Array.from(document.querySelectorAll<HTMLElement>("[data-panel]")).map((el) => [
          el.dataset.panel!,
          el,
        ]),
      );
      const loadedPanels = new Set<string>();

      function activateTab(key: string) {
        for (const button of tabButtons) {
          const active = button.dataset.tab === key;
          button.setAttribute("aria-selected", String(active));
        }
        for (const [panelKey, el] of panels) {
          el.hidden = panelKey !== key;
        }
        if (!loadedPanels.has(key)) {
          loadedPanels.add(key);
          if (key === "bins") void initBins();
          if (key === "trade") void initTrade();
          if (key === "account") void initAccount();
        }
      }
      tabButtons.forEach((button) =>
        button.addEventListener("click", () => activateTab(button.dataset.tab!)),
      );
      document.querySelectorAll<HTMLButtonElement>("[data-goto]").forEach((button) =>
        button.addEventListener("click", () => activateTab(button.dataset.goto!)),
      );
      document
        .querySelector<HTMLButtonElement>("[data-topbar-address]")!
        .addEventListener("click", () => activateTab("account"));

      const globalSearchInput = document.querySelector<HTMLInputElement>("[data-global-search]")!;
      globalSearchInput.addEventListener("input", () => {
        const value = globalSearchInput.value;
        activateTab("trade");
        closeAssetView();
        const tradeSearchInput = document.querySelector<HTMLInputElement>("[data-trade-search]")!;
        tradeSearchInput.value = value;
        tradeQuery = value.trim().toLowerCase();
        if (tradeAssets) renderTradeList(document.querySelector<HTMLElement>("[data-trade-list]")!);
      });

      // ---- Shared market data ----
      let hoodData: HoodData | null = null;
      let hoodDataPromise: Promise<HoodData> | null = null;
      function getHoodData(): Promise<HoodData> {
        hoodDataPromise ??= loadTokens().then((data) => (hoodData = data));
        return hoodDataPromise;
      }

      let positionsCache: BinPosition[] | null = null;
      async function getPositions(force = false): Promise<BinPosition[]> {
        if (!trader) return [];
        if (positionsCache && !force) return positionsCache;
        const data = await getHoodData();
        positionsCache = await loadPositions(trader.address, data.tokens);
        return positionsCache;
      }

      // ---- Home ----
      // Featured symbols for Top Assets / the ticker row: every symbol used
      // across the bin catalog, deduped, in catalog order.
      const featuredSymbols = [...new Set(bins.flatMap((bin) => bin.legs.map((leg) => leg.symbol)))];

      function pct(value: number): string {
        return `${value >= 0 ? "+" : ""}${value.toFixed(2)}%`;
      }
      function changeClass(value: number): string {
        return value >= 0 ? "change-up" : "change-down";
      }

      function renderPositionsTable(container: HTMLElement, positions: BinPosition[]) {
        if (positions.length === 0) {
          container.className = "empty";
          container.textContent = "No open positions yet. Open a bin to take a framing.";
          return;
        }
        container.className = "table-wrap";
        const rows = positions
          .map(
            (position) => `
              <tr>
                <td><div class="cell-identity">${legStackHtml(position.legs.map((leg) => leg.symbol))}${position.bin.name}</div></td>
                <td class="cell-muted">${position.legs.map((leg) => leg.symbol).join(", ")}</td>
                <td class="cell-value">${usd(position.valueUsdg)}</td>
              </tr>
            `,
          )
          .join("");
        container.innerHTML = `
          <table class="data-table">
            <thead><tr><th>Bin</th><th>Legs</th><th style="text-align:right">Value</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
        `;
      }

      function renderTopAssets(
        container: HTMLElement,
        symbols: string[],
        charts: Record<string, { price: number; changePercent: number }>,
      ) {
        container.className = "asset-list";
        container.innerHTML = symbols
          .map((symbol) => {
            const chart = charts[symbol];
            return `
              <div class="asset-row">
                ${markForSymbol(symbol)}
                <span class="asset-row__identity">${symbol}</span>
                <span class="asset-row__price">${chart ? usd(chart.price) : "—"}</span>
                <span class="asset-row__change ${chart ? changeClass(chart.changePercent) : ""}">${chart ? pct(chart.changePercent) : "—"}</span>
              </div>
            `;
          })
          .join("");
      }

      function renderTicker(
        container: HTMLElement,
        symbols: string[],
        charts: Record<string, { price: number; changePercent: number }>,
      ) {
        container.className = "ticker-row";
        container.innerHTML = symbols
          .map((symbol) => {
            const chart = charts[symbol];
            return `
              <div class="ticker-card">
                <div class="ticker-card__head">
                  ${markForSymbol(symbol)}
                  <span class="ticker-card__symbol">${symbol}</span>
                </div>
                <span class="ticker-card__price">${chart ? usd(chart.price) : "—"}</span>
                <span class="ticker-card__change ${chart ? changeClass(chart.changePercent) : ""}">${chart ? `${pct(chart.changePercent)} today` : "—"}</span>
              </div>
            `;
          })
          .join("");
      }

      function filterHistoryByRange(
        history: PortfolioSnapshot[],
        range: "1d" | "7d" | "30d" | "all",
      ): PortfolioSnapshot[] {
        if (range === "all") return history;
        const days = range === "1d" ? 1 : range === "7d" ? 7 : 30;
        const cutoff = Date.now() - days * 86_400_000;
        return history.filter((snapshot) => Date.parse(snapshot.createdAt) >= cutoff);
      }

      function renderLineChart(container: HTMLElement, values: number[], emptyMessage: string) {
        if (values.length < 2) {
          container.innerHTML = `<div class="chart-empty">${emptyMessage}</div>`;
          return;
        }
        const min = Math.min(...values);
        const max = Math.max(...values);
        const range = max - min || 1;
        const w = 600;
        const h = 200;
        const pad = 8;
        const points = values
          .map((value, i) => {
            const x = pad + (i / (values.length - 1)) * (w - pad * 2);
            const y = h - pad - ((value - min) / range) * (h - pad * 2);
            return `${x.toFixed(1)},${y.toFixed(1)}`;
          })
          .join(" ");
        container.innerHTML = `
          <svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
            <polyline points="${points}" fill="none" stroke="#7165ed" stroke-width="2" />
          </svg>
        `;
      }

      function renderPortfolioChart(container: HTMLElement, snapshots: PortfolioSnapshot[]) {
        renderLineChart(
          container,
          snapshots.map((s) => s.totalValue),
          "Portfolio history builds up as you use the app — each visit adds a real data point. Check back soon.",
        );
      }

      async function initHome() {
        if (!trader) return;
        const balanceEl = document.querySelector<HTMLElement>("[data-home-balance]")!;
        const updatedEl = document.querySelector<HTMLElement>("[data-home-updated]")!;
        const refreshButton = document.querySelector<HTMLButtonElement>("[data-home-refresh]")!;
        const topAssetsEl = document.querySelector<HTMLElement>("[data-top-assets]")!;
        const tickerEl = document.querySelector<HTMLElement>("[data-ticker-row]")!;
        const portfolioValueEl = document.querySelector<HTMLElement>("[data-portfolio-value]")!;
        const portfolioChangeEl = document.querySelector<HTMLElement>("[data-portfolio-change]")!;
        const chartEl = document.querySelector<HTMLElement>("[data-portfolio-chart]")!;
        const positionsTableEl = document.querySelector<HTMLElement>("[data-home-positions-table]")!;
        const rangeButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-portfolio-range] [data-range]"),
        );

        let currentBalance = 0;
        await loadAssetRegistry().catch(() => {});

        async function refreshBalance() {
          currentBalance = await loadUsdgBalance(trader!.address);
          balanceEl.textContent = usd(currentBalance);
          updatedEl.textContent = new Date().toLocaleTimeString();
        }
        refreshButton.addEventListener("click", () => void refreshBalance().catch(() => {}));
        await refreshBalance().catch(() => {
          balanceEl.textContent = "—";
        });

        const positions = await getPositions().catch(() => [] as BinPosition[]);
        const positionsValue = positions.reduce((sum, p) => sum + p.valueUsdg, 0);
        renderPositionsTable(positionsTableEl, positions);
        portfolioValueEl.textContent = usd(currentBalance + positionsValue);

        void snapshotPortfolio({
          owner: trader.address,
          usdgBalance: currentBalance,
          positionsValue,
        }).catch(() => {});

        let history: PortfolioSnapshot[] = [];
        try {
          history = await fetchPortfolioHistory(trader.address);
        } catch {
          // No history yet — the chart renders its own empty state.
        }

        let currentRange: "1d" | "7d" | "30d" | "all" = "1d";
        function renderChart() {
          const filtered = filterHistoryByRange(history, currentRange);
          renderPortfolioChart(chartEl, filtered);
          if (filtered.length >= 2) {
            const change =
              ((filtered[filtered.length - 1].totalValue - filtered[0].totalValue) /
                (filtered[0].totalValue || 1)) *
              100;
            portfolioChangeEl.textContent = `${pct(change)} this range`;
            portfolioChangeEl.className = `chart-change ${changeClass(change)}`;
          } else {
            portfolioChangeEl.textContent = "";
            portfolioChangeEl.className = "chart-change";
          }
        }
        rangeButtons.forEach((button) =>
          button.addEventListener("click", () => {
            currentRange = button.dataset.range as "1d" | "7d" | "30d" | "all";
            rangeButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            renderChart();
          }),
        );
        renderChart();

        try {
          const charts = await fetchMarketCharts(featuredSymbols);
          renderTopAssets(topAssetsEl, featuredSymbols, charts);
          renderTicker(tickerEl, featuredSymbols.slice(0, 4), charts);
        } catch (error) {
          const message = error instanceof Error ? error.message : String(error);
          topAssetsEl.className = "error-text";
          topAssetsEl.textContent = message;
          tickerEl.className = "error-text";
          tickerEl.textContent = message;
        }
      }

      // ---- Bins ----
      async function initBins() {
        const carousel = document.querySelector<HTMLElement>("[data-bins-carousel]")!;
        carousel.className = "carousel";
        carousel.innerHTML = "";
        await loadAssetRegistry().catch(() => {});
        for (const bin of bins) {
          const card = document.createElement("button");
          card.type = "button";
          card.className = "tile-card";
          card.innerHTML = `
            ${legStackHtml(bin.legs.map((leg) => leg.symbol))}
            <span class="tile-card__name">${bin.name}</span>
            <span class="tile-card__thesis">${bin.thesis}</span>
            <div class="tile-card__legs">
              ${bin.legs.map((leg) => `<div class="tile-leg"><span>${leg.symbol}</span><span>${(leg.weightBps / 100).toFixed(0)}%</span></div>`).join("")}
            </div>
          `;
          card.addEventListener("click", () => openBinModal(bin));
          carousel.appendChild(card);
        }
      }

      function openBinModal(bin: Bin) {
        const detail = openModal(`
          <div class="modal__head">
            <div class="modal__identity">${legStackHtml(bin.legs.map((leg) => leg.symbol))}<span class="modal__title">${bin.name}</span></div>
            <button type="button" class="modal__close" data-close>×</button>
          </div>
          <p class="quote-line">${bin.thesis}</p>
          <div class="amount-row">
            <span>$</span>
            <input type="number" min="0" step="any" placeholder="0" data-bin-amount />
          </div>
          <button type="button" class="btn btn--primary" data-bin-size>Size this bin</button>
          <div data-bin-sizing></div>
          <p class="status-line" data-bin-status></p>
        `);
        const status = detail.querySelector<HTMLElement>("[data-bin-status]")!;
        const sizingEl = detail.querySelector<HTMLElement>("[data-bin-sizing]")!;
        const amountInput = detail.querySelector<HTMLInputElement>("[data-bin-amount]")!;

        detail.querySelector<HTMLButtonElement>("[data-bin-size]")!.addEventListener("click", async () => {
          const amount = Number(amountInput.value);
          if (!(amount > 0)) {
            status.textContent = "Enter an amount greater than 0.";
            status.dataset.tone = "error";
            return;
          }
          status.textContent = "Pricing every leg…";
          status.dataset.tone = "";
          sizingEl.innerHTML = "";
          try {
            const data = await getHoodData();
            const { sized, issues } = await sizeBinFor(bin, amount, data.tokens);
            status.textContent = "";
            if (sized.legs.length === 0) {
              sizingEl.innerHTML = `<p class="warn-line">${issues.map((i) => i.detail).join(" · ") || "No legs could be sized."}</p>`;
              return;
            }
            sizingEl.innerHTML =
              sized.legs
                .map((leg) => `<div class="leg-row"><span>${leg.leg.symbol}</span><span>${usd(leg.usdgIn)}</span></div>`)
                .join("") +
              (issues.length > 0 ? `<p class="warn-line">${issues.map((i) => i.detail).join(" · ")}</p>` : "") +
              `<button type="button" class="btn btn--primary" data-bin-confirm style="margin-top:12px">Open bin with my passkey</button>`;
            sizingEl.querySelector<HTMLButtonElement>("[data-bin-confirm]")!.addEventListener("click", async () => {
              if (!trader) return;
              const button = sizingEl.querySelector<HTMLButtonElement>("[data-bin-confirm]")!;
              button.disabled = true;
              status.dataset.tone = "";
              try {
                status.textContent = "Waiting for your passkey…";
                await openBin(trader, sized, (step) => (status.textContent = stepLabels[step]));
                status.textContent = `Opened ${bin.name}.`;
                await getPositions(true);
                void initHome();
              } catch (error) {
                status.dataset.tone = "error";
                status.textContent = error instanceof Error ? error.message : String(error);
                button.disabled = false;
              }
            });
          } catch (error) {
            status.dataset.tone = "error";
            status.textContent = error instanceof Error ? error.message : String(error);
          }
        });
      }

      // ---- Trade ----
      let tradeAssets: TradeAsset[] | null = null;
      let tradeQuery = "";
      let tradeCategory: "all" | "held" = "all";

      async function initTrade() {
        const listEl = document.querySelector<HTMLElement>("[data-trade-list]")!;
        const searchInput = document.querySelector<HTMLInputElement>("[data-trade-search]")!;
        const categoryRow = document.querySelector<HTMLElement>("[data-trade-category]")!;

        searchInput.addEventListener("input", () => {
          tradeQuery = searchInput.value.trim().toLowerCase();
          renderTradeList(listEl);
        });
        categoryRow.querySelectorAll<HTMLButtonElement>("[data-category]").forEach((button) => {
          button.addEventListener("click", () => {
            tradeCategory = button.dataset.category as "all" | "held";
            categoryRow.querySelectorAll("[data-category]").forEach((b) => b.classList.toggle("chip--active", b === button));
            renderTradeList(listEl);
          });
        });

        try {
          const [data, safeEntries] = await Promise.all([getHoodData(), fetchTradableSymbols()]);
          const safeSymbols = new Set(safeEntries.map((entry) => entry.symbol));
          const allAssets = await loadTradeAssets(data.tokens);
          // Some Robinhood Chain Stock Tokens have a pool with almost no
          // liquidity — the quote succeeds but the price is nowhere near
          // real. Only list symbols the backend has verified price against
          // its own reference feed, not just "a pool exists".
          tradeAssets = allAssets.filter((asset) => safeSymbols.has(asset.token.symbol));
          renderTradeList(listEl);
        } catch (error) {
          listEl.className = "error-text";
          listEl.textContent = error instanceof Error ? error.message : String(error);
        }
      }

      function renderTradeList(listEl: HTMLElement) {
        if (!tradeAssets) return;
        const heldSymbols = new Set(
          (positionsCache ?? []).flatMap((position) => position.legs.map((leg) => leg.symbol)),
        );
        const filtered = tradeAssets.filter((asset) => {
          if (tradeCategory === "held" && !heldSymbols.has(asset.token.symbol)) return false;
          if (tradeQuery === "") return true;
          return (
            asset.token.symbol.toLowerCase().includes(tradeQuery) ||
            asset.token.name.toLowerCase().includes(tradeQuery)
          );
        });
        if (filtered.length === 0) {
          listEl.className = "empty";
          listEl.textContent = tradeCategory === "held" ? "No direct holdings from a bin yet." : "No tokens match that search.";
          return;
        }
        listEl.className = "table-wrap";
        const rows = filtered
          .map(
            (asset) => `
              <tr data-symbol="${asset.token.symbol}">
                <td><div class="cell-identity">${markHtml(stockLogoUrl(asset.token.symbol), asset.token.symbol)}${asset.token.symbol}</div></td>
                <td class="cell-muted">${asset.token.name}</td>
                <td class="cell-value">${asset.price === null ? "—" : asset.halted ? "Halted" : usd(asset.price)}</td>
              </tr>
            `,
          )
          .join("");
        listEl.innerHTML = `
          <table class="data-table">
            <thead><tr><th>Symbol</th><th>Name</th><th style="text-align:right">Price</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>
        `;
        listEl.querySelectorAll<HTMLTableRowElement>("tbody tr").forEach((row) => {
          const asset = filtered.find((a) => a.token.symbol === row.dataset.symbol);
          if (asset) row.addEventListener("click", () => openAssetView(asset));
        });
      }

      const buyPresets = [10, 25, 50, 100];
      const sellPresetFractions = [0.25, 0.5, 0.75, 1];

      const assetBackButton = document.querySelector<HTMLButtonElement>("[data-asset-back]")!;
      const tradeListView = document.querySelector<HTMLElement>("[data-trade-list-view]")!;
      const assetView = document.querySelector<HTMLElement>("[data-asset-view]")!;
      assetBackButton.addEventListener("click", closeAssetView);

      function closeAssetView() {
        assetView.hidden = true;
        tradeListView.hidden = false;
      }

      async function openAssetView(asset: TradeAsset) {
        tradeListView.hidden = true;
        assetView.hidden = false;

        const headerEl = document.querySelector<HTMLElement>("[data-asset-header]")!;
        const priceEl = document.querySelector<HTMLElement>("[data-asset-price]")!;
        const changeEl = document.querySelector<HTMLElement>("[data-asset-change]")!;
        const chartEl = document.querySelector<HTMLElement>("[data-asset-chart]")!;
        const statsEl = document.querySelector<HTMLElement>("[data-asset-stats]")!;
        const rangeButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>("[data-asset-range] [data-range]"),
        );
        const holdingLine = document.querySelector<HTMLElement>("[data-asset-holding]")!;
        const status = document.querySelector<HTMLElement>("[data-asset-status]")!;
        const modeBody = document.querySelector<HTMLElement>("[data-asset-mode-body]")!;
        const modeButtons = Array.from(
          document.querySelectorAll<HTMLButtonElement>(".card--trade-panel [data-mode]"),
        );

        headerEl.innerHTML = `<div class="modal__identity">${markHtml(stockLogoUrl(asset.token.symbol), asset.token.symbol)}<span class="modal__title">${asset.token.symbol} · ${asset.token.name}</span></div>`;
        priceEl.textContent = asset.price === null ? "—" : usd(asset.price);
        changeEl.textContent = "";
        statsEl.innerHTML = "";
        chartEl.innerHTML = "";
        holdingLine.textContent = "";
        status.textContent = "";
        status.className = "status-line";

        let mode: "buy" | "sell" = "buy";
        let pool: unknown = "checking";
        let holding = { raw: 0n, shares: 0 };
        let currentRange: ChartRange = "5d";

        if (!trader) return;

        checkTradable(asset.token)
          .then((found) => (pool = found))
          .catch(() => (pool = null));
        loadTokenHolding(trader.address, asset.token)
          .then((next) => {
            holding = next;
            if (holding.shares > 0) {
              holdingLine.textContent = `You hold ${holding.shares.toLocaleString(undefined, { maximumFractionDigits: 6 })} ${asset.token.symbol}`;
            }
          })
          .catch(() => {});

        async function loadChart(range: ChartRange) {
          chartEl.innerHTML = `<div class="chart-empty">Loading…</div>`;
          try {
            const chart = await fetchMarketChart(asset.token.symbol, range);
            renderLineChart(
              chartEl,
              chart.points.map((p) => p.close),
              "No chart history for this range.",
            );
            changeEl.textContent = `${pct(chart.changePercent)} today`;
            changeEl.className = `asset-price-change ${changeClass(chart.changePercent)}`;
            statsEl.innerHTML = `
              <div class="stat-card"><span class="stat-card__label">Volume</span><span class="stat-card__value" style="font-size:18px">${chart.volume.toLocaleString()}</span></div>
              <div class="stat-card"><span class="stat-card__label">Previous close</span><span class="stat-card__value" style="font-size:18px">${usd(chart.previousClose)}</span></div>
              <div class="stat-card"><span class="stat-card__label">You hold</span><span class="stat-card__value" style="font-size:18px">${holding.shares > 0 ? holding.shares.toLocaleString(undefined, { maximumFractionDigits: 4 }) : "—"}</span></div>
            `;
          } catch {
            chartEl.innerHTML = `<div class="chart-empty">Chart unavailable right now.</div>`;
          }
        }
        rangeButtons.forEach((button) =>
          button.addEventListener("click", () => {
            currentRange = button.dataset.range as ChartRange;
            rangeButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            void loadChart(currentRange);
          }),
        );
        void loadChart(currentRange);

        function renderMode() {
          if (mode === "buy") {
            modeBody.innerHTML = `
              <div class="amount-row"><span>$</span><input type="number" min="0" step="any" placeholder="0" data-amount /></div>
              <div class="chip-row">${buyPresets.map((p) => `<button type="button" class="chip" data-preset="${p}">$${p}</button>`).join("")}</div>
              <button type="button" class="btn btn--primary" style="margin-top:12px" data-submit>Buy ${asset.token.symbol}</button>
            `;
          } else {
            modeBody.innerHTML = `
              <div class="amount-row"><input type="number" min="0" step="any" placeholder="0" data-amount /><span>${asset.token.symbol}</span></div>
              <div class="chip-row">${sellPresetFractions.map((f) => `<button type="button" class="chip" data-preset-fraction="${f}">${f === 1 ? "Max" : `${f * 100}%`}</button>`).join("")}</div>
              <button type="button" class="btn btn--primary" style="margin-top:12px" data-submit>Sell ${asset.token.symbol}</button>
            `;
          }
          wireMode();
        }

        function wireMode() {
          const amountInput = modeBody.querySelector<HTMLInputElement>("[data-amount]")!;
          modeBody.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((button) =>
            button.addEventListener("click", () => (amountInput.value = button.dataset.preset!)),
          );
          modeBody.querySelectorAll<HTMLButtonElement>("[data-preset-fraction]").forEach((button) =>
            button.addEventListener("click", () => {
              const fraction = Number(button.dataset.presetFraction);
              amountInput.value = String(holding.shares * fraction);
            }),
          );
          modeBody.querySelector<HTMLButtonElement>("[data-submit]")!.addEventListener("click", async () => {
            const amount = Number(amountInput.value);
            if (!(amount > 0)) {
              status.dataset.tone = "error";
              status.textContent = "Enter an amount greater than 0.";
              return;
            }
            if (pool === null) {
              status.dataset.tone = "error";
              status.textContent = "No onchain market for this token yet.";
              return;
            }
            const button = modeBody.querySelector<HTMLButtonElement>("[data-submit]")!;
            button.disabled = true;
            status.dataset.tone = "";
            try {
              if (mode === "buy") {
                status.textContent = "Pricing…";
                const quote = await quoteTrade(asset.token, amount);
                if (!quote) throw new Error("No quote available.");
                status.textContent = "Waiting for your passkey…";
                await buyToken(trader!, asset.token, amount, quote, (step) => (status.textContent = stepLabels[step]));
                status.textContent = `Bought ${asset.token.symbol}.`;
              } else {
                if (amount > holding.shares) throw new Error("More than you hold.");
                status.textContent = "Pricing…";
                const quote = await quoteSell(asset.token, amount);
                if (!quote) throw new Error("No quote available.");
                const amountInRaw =
                  holding.shares > 0
                    ? (holding.raw * BigInt(Math.round((amount / holding.shares) * 1_000_000))) / 1_000_000n
                    : 0n;
                status.textContent = "Waiting for your passkey…";
                await sellToken(trader!, asset.token, amountInRaw, quote, (step) => (status.textContent = stepLabels[step]));
                status.textContent = `Sold ${asset.token.symbol}.`;
              }
              holding = await loadTokenHolding(trader!.address, asset.token);
              if (holding.shares > 0) {
                holdingLine.textContent = `You hold ${holding.shares.toLocaleString(undefined, { maximumFractionDigits: 6 })} ${asset.token.symbol}`;
              }
              await getPositions(true);
              void initHome();
            } catch (error) {
              status.dataset.tone = "error";
              status.textContent = error instanceof Error ? error.message : String(error);
            } finally {
              button.disabled = false;
            }
          });
        }

        modeButtons.forEach((button) =>
          button.addEventListener("click", () => {
            mode = button.dataset.mode as "buy" | "sell";
            modeButtons.forEach((b) => b.classList.toggle("chip--active", b === button));
            status.textContent = "";
            renderMode();
          }),
        );
        renderMode();
      }

      // ---- Account ----
      function initAccount() {
        if (!trader) return;
        const nameInput = document.querySelector<HTMLInputElement>("[data-profile-name]")!;
        const emailInput = document.querySelector<HTMLInputElement>("[data-profile-email]")!;
        const saveButton = document.querySelector<HTMLButtonElement>("[data-save-profile]")!;
        const shuffleButton = document.querySelector<HTMLButtonElement>("[data-shuffle]")!;
        const signOutButton = document.querySelector<HTMLButtonElement>("[data-sign-out]")!;
        const status = document.querySelector<HTMLElement>("[data-account-status]")!;

        const profileKey = "opencash.profile";
        type Profile = { name: string; email: string; variant?: number };
        let variant = 0;

        function loadProfile(): Profile | null {
          const raw = localStorage.getItem(profileKey);
          if (raw === null) return null;
          try {
            return JSON.parse(trader!.openProfile(JSON.parse(raw)));
          } catch {
            return null;
          }
        }
        function saveProfile(value: Profile) {
          localStorage.setItem(profileKey, JSON.stringify(trader!.sealProfile(JSON.stringify(value))));
        }

        async function paint() {
          const { avatarDataUri, avatarSeed, shortenAddress } = await avatars();
          const nameEl = document.querySelector<HTMLElement>("[data-account-name]");
          const emailEl = document.querySelector<HTMLElement>("[data-account-email]");
          const avatarEl = document.querySelector<HTMLImageElement>("[data-account-avatar]");
          const profile = loadProfile();
          variant = profile?.variant ?? 0;
          nameInput.value = profile?.name ?? "";
          emailInput.value = profile?.email ?? "";
          if (nameEl) nameEl.textContent = profile?.name || "Trader";
          if (emailEl) emailEl.textContent = profile?.email ?? "";
          if (avatarEl) {
            avatarEl.src = avatarDataUri(avatarSeed(trader!.address, variant));
            avatarEl.alt = `Avatar for ${shortenAddress(trader!.address)}`;
          }
        }
        void paint();

        saveButton.addEventListener("click", () => {
          saveProfile({ name: nameInput.value.trim(), email: emailInput.value.trim(), variant });
          status.textContent = "Saved on this device, encrypted with a key only your passkey derives.";
          void paint();
        });
        shuffleButton.addEventListener("click", () => {
          variant = (variant + 1) % 12;
          const profile = loadProfile();
          saveProfile({ name: profile?.name ?? "", email: profile?.email ?? "", variant });
          void paint();
        });
        signOutButton.addEventListener("click", () => {
          trader?.end();
          trader = null;
          dash.hidden = true;
          gate.hidden = false;
          sayGate("Signed out. The derived key was zeroed.");
        });

        document.querySelector<HTMLButtonElement>("[data-copy]")?.addEventListener("click", async () => {
          if (!trader) return;
          await navigator.clipboard.writeText(trader.address);
          const hint = document.querySelector<HTMLElement>("[data-copy-hint]");
          if (hint) {
            hint.textContent = "Copied";
            setTimeout(() => (hint.textContent = "Copy"), 1400);
          }
        });
      }
    </script>
  </body>
</html>
