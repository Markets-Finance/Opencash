---
import "../styles/landing.css";
import Mark from "../components/Mark.astro";
const stages = [
  {
    name: "Collateral",
    description:
      "Supply gAUSD, vUSD or PT-AUSD. It keeps earning while it backs the position.",
    position: "issue",
  },
  {
    name: "Notional",
    description:
      "Size is margin × leverage. Nothing is lent and no interest accrues.",
    position: "verify",
  },
  {
    name: "Bins",
    description:
      "Take a whole framing in one tap, or size a single leg inside it.",
    position: "collateral",
  },
  {
    name: "Settlement",
    description:
      "Your passkey signs every call. OpenCash never holds withdrawal power.",
    position: "settlement",
  },
];
const applications = [
  {
    id: "notional",
    tab: "Notional trading",
    audience: "FOR LEVERAGE",
    title: "Size without borrowing.",
    text: "Notional is margin × leverage — accounting, not a loan. Nothing is lent, no interest accrues, and there is no lending pool on the critical path.",
    image: "skyline",
    label: "NOTIONAL / MARGIN × LEVERAGE",
    facts: [
      ["Size", "margin × leverage"],
      ["Borrowed", "Nothing"],
      ["Liquidation", "Euler's engine, not ours"],
    ],
  },
  {
    id: "collateral",
    tab: "Idle collateral",
    audience: "FOR gAUSD & vUSD HOLDERS",
    title: "Margin that never stops earning.",
    text: "Collateral stays in the Euler vault it already sits in, under your own sub-account. The yield keeps running for as long as the position is open.",
    image: "skyline",
    label: "COLLATERAL / EULER VAULTS",
    facts: [
      ["Accepted", "gAUSD · vUSD · PT-AUSD"],
      ["Held in", "Euler vaults, your sub-account"],
      ["Yield", "Runs while the position is open"],
    ],
  },
  {
    id: "bins",
    tab: "Bins",
    audience: "FOR ANYONE WITH A VIEW",
    title: "The framing is the instrument.",
    text: "A bin pools assets around one theme — AI capex, a name in the headlines, gold against the dollar — with analytics on every pool. Institutions size into a framing, or out of it, in a single call.",
    image: "skyline-bins",
    label: "THEMATIC BINS / POOLED FRAMING",
    facts: [
      ["Composition", "Pooled around one theme"],
      ["Pricing", "Each leg on its own venue"],
      ["Feeds", "Official markets only"],
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="OpenCash is a mobile trading terminal on Monad. Collateral keeps earning in Euler vaults, notional is accounting rather than debt, and bins turn a narrative into one position."
    />
    <meta name="author" content="Daiwik Maheshwari" />
    <meta name="creator" content="Daiwik Maheshwari" />
    <meta name="publisher" content="OpenCash" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenCash" />
    <meta property="og:title" content="OpenCash — Mobile trading on Monad" />
    <meta property="og:description" content="Collateral that keeps earning, notional that borrows nothing, and thematic bins — in one mobile terminal on Monad." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="OpenCash — Mobile trading on Monad" />
    <meta name="twitter:description" content="Collateral that keeps earning, notional that borrows nothing, and thematic bins — in one mobile terminal on Monad." />
    <meta name="theme-color" content="#191a1c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/images/skyline.webp" as="image" />
    <title>OpenCash — Mobile trading on Monad</title>
  </head>
  <body>
    <!-- THESIS: Reveal the market beneath the real world through an interactive photographic canvas.
      OWN-WORLD: Night skyline photography, saturated window colour, violet type, diamond anchors and pixel masks.
      STORY: Explore idle collateral, understand how a position forms, then interact with a clearly labelled product demo.
      FIRST VIEWPORT: Full-bleed skyline, centered floating navigation, cursor scanner, low single-line headline.
      FORM: User-pinned Geolava reference; original OpenCash content and canvas implementation.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="navigation" aria-label="Main navigation">
        <a class="wordmark" href="#home" aria-label="OpenCash home"
          ><Mark />open<span>cash</span></a
        >
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          >Menu <span aria-hidden="true">+</span></button
        >
        <div class="nav-links" id="nav-links">
          <a href="#home" class="active">Home</a><a href="#assets">Bins</a
          ><a href="#platform">Platform</a><a href="#about">About</a>
        </div>
        <a class="nav-cta" href="#waitlist"
          ><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
          > Join waitlist</a
        >
      </nav>
    </header>
    <main id="main">
      <section
        id="home"
        class="hero scanner"
        data-scanner
        aria-label="Interactive market landscape"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          width="1376"
          height="768"
          alt="A dense night skyline with one exchange tower lit in bands of colour"
          fetchpriority="high"
        />
        <canvas class="scan-canvas" aria-hidden="true"></canvas>
        <div class="hero-heading">
          <h1>Trade everything.<br class="mobile-break" /> Borrow nothing.</h1><p>
            A full mobile trading terminal on Monad. Size is notional, not debt — and your margin comes from gAUSD and vUSD already earning in Euler.
          </p>
        </div>
        <div class="scan-controls">
          <button class="scan-toggle" aria-pressed="false"
            ><svg viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M5 3v10M11 3v10"></path></svg
            ><span>Pause scan</span></button
          ><span class="scan-hint">Move to discover ↗</span>
        </div>
        <div class="hero-caption">
          <span class="status-dot"></span> Interactive visualisation <span
            >/</span
          > Illustrative, not live market data
        </div>
        <a class="scroll-cue" href="#about" aria-label="Discover OpenCash"
          ><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M12 3v17m-6-6 6 6 6-6"></path></svg
          ></a
        >
      </section>
      <section class="intro section-frame" id="about">
        <h2>
          One terminal.<br />Every market.<br />Nothing borrowed.
        </h2>
        <div class="intro-bottom">
          <span class="section-name"><i></i> WHY OPENCASH</span><p>
            A full trading interface on Monad, where notional is accounting rather
            than debt, margin comes from assets already earning, and a bin takes a whole framing in one call.
          </p>
        </div>
        <span class="frame-node left"></span><span class="frame-node right"
        ></span>
      </section>
      <section
        class="asset-landscape scanner"
        data-scanner
        id="platform"
        aria-labelledby="landscape-title"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          width="1376"
          height="768"
          loading="lazy"
          alt="A night skyline annotated with the stages of an open position"
        />
        <canvas class="scan-canvas" aria-hidden="true"></canvas>
        <div class="pixel-edge" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </div>
        <h2 id="landscape-title">One deposit.<br />A whole market.</h2>
        <div class="asset-pins">
          {
            stages.map((stage, i) => (
              <button
                class={`asset-pin ${stage.position}`}
                data-stage={i}
                aria-expanded={i === 0 ? "true" : "false"}
              >
                <>
                  <span class="pin-anchor" aria-hidden="true" />
                  <span class="pin-content">
                    <>
                      <span class="pin-title">
                        {stage.name}
                        <span aria-hidden="true">↗</span>
                      </span>
                      <span class="pin-description">{stage.description}</span>
                    </>
                  </span>
                </>
              </button>
            ))
          }
        </div>
        <span class="landscape-caption"
          >SELECT A POINT TO EXPLORE A POSITION</span
        >
      </section>
      <section
        class="connection section-frame"
        aria-labelledby="connection-title"
      >
        <div class="section-heading">
          <h2 id="connection-title">
            From idle collateral<br />to an open position.
          </h2><p>
            OpenCash sits between Euler's vaults and Monad's venues. Notional is
            accounting rather than debt, margin keeps earning while it backs you, and every call is signed by your own passkey.
          </p>
        </div>
        <div
          class="connection-graphic"
          aria-label="Collateral connects to notional sizing, thematic bins, and passkey-signed settlement"
        >
          <svg
            class="connection-lines"
            viewBox="0 0 1000 360"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path
              d="M120 80H360L500 180 640 80H880M120 280H360L500 180 640 280H880M500 0V360"
            ></path><path class="flow-line" d="M120 80H360L500 180 640 280H880"
            ></path></svg
          >
          <div class="connection-center">
            <div class="diamond-stack" aria-hidden="true">
              <i></i><i></i><i></i>
            </div><Mark class="center-mark" /><strong>open</strong><span>CASH</span>
          </div>
          <span class="connection-label top-left">Yield-bearing collateral</span
          ><span class="connection-label bottom-left"
            >Unbacked notional</span
          ><span class="connection-label top-right">Thematic bins</span
          ><span class="connection-label bottom-right"
            >Passkey-signed calls</span
          >
        </div>
        <div class="tech-strip">
          <span>BUILT ON</span><span class="chain-mark"
            ><b>Monad</b></span
          ><span>Euler vaults</span><span
            >Passkey signing ↗</span>
        </div>
      </section>
      <section
        class="applications section-frame"
        id="assets"
        aria-labelledby="applications-title"
      >
        <div class="section-heading">
          <h2 id="applications-title">
            Trade a market.<br />Or a whole framing.
          </h2><p>
            Notional sizing that borrows nothing, margin drawn from assets already
            earning, and bins that pool a theme into one position.
          </p>
        </div>
        <div
          class="application-tabs"
          role="tablist"
          aria-label="Trading surfaces"
        >
          {
            applications.map((app, i) => (
              <button
                id={`tab-${app.id}`}
                role="tab"
                aria-selected={i === 0}
                aria-controls={`panel-${app.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-tab={app.id}
              >
                {app.tab}
                <span aria-hidden="true">↗</span>
              </button>
            ))
          }
        </div>
        {
          applications.map((app, i) => (
            <div
              class="application-panel"
              id={`panel-${app.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${app.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <div class={`application-image ${app.id}-image`}>
                <>
                  <img
                    src={`/images/${app.image}.webp`}
                    alt={`Illustrative night skyline for ${app.tab.toLowerCase()}`}
                    loading="lazy"
                    width="1376"
                    height="768"
                  />
                  <span class="image-bracket" />
                  <span class="image-label">{app.label}</span>
                </>
              </div>
              <div class="application-content">
                <>
                  <span class="small-label">{app.audience}</span>
                  <h3>{app.title}</h3>
                  <p>{app.text}</p>
                  <dl>
                    {app.facts.map(([label, value]) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                  <a class="text-link" href="#explore">
                    Explore the flow{" "}
                    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 12h15m-6-6 6 6-6 6" />
                    </svg>
                  </a>
                </>
              </div>
            </div>
          ))
        }
        <p class="section-footnote">
          Proposed surfaces. No live markets are listed on OpenCash yet.
        </p>
      </section>
      <section
        class="demo-section section-frame"
        id="explore"
        aria-labelledby="demo-title"
      >
        <div class="section-heading">
          <h2 id="demo-title">See a position form.<br />Make the next move.</h2><p
          >
            A small, interactive look at the terminal we’re building. Walk a
            sample bin from idle collateral to a signed call.
          </p>
        </div>
        <div class="demo-workspace">
          <div class="demo-summary">
            <span class="small-label"
              ><i class="status-dot"></i> INTERACTIVE DEMO</span
            ><h3>OpenCash Sample Bin</h3><p>
              Illustrative basket · No funds or transactions are sent.
            </p><div class="demo-asset-mark" aria-hidden="true">
              <svg viewBox="0 0 200 200"
                ><path
                  d="m100 20 80 45v75l-80 45-80-45V65Zm0 0v80m-80-35 80 35 80-35m-80 35v85m-80-45 80-40 80 40"
                ></path></svg>
            </div><span class="demo-caption"
              >A CLEAR PATH FROM IDEA TO POSITION</span>
          </div>
          <div class="demo-flow">
            <ol class="workflow-steps">
              {
                [
                  "Supply idle collateral",
                  "Pick a bin",
                  "Set the notional",
                  "Sign with your passkey",
                ].map((step, i) => (
                  <li data-demo-step={i} class={i === 0 ? "current" : ""}>
                    <>
                      <span class="step-number">0{i + 1}</span>
                      <span>{step}</span>
                      <span class="step-state">
                        {i === 0 ? "Ready" : "Upcoming"}
                      </span>
                    </>
                  </li>
                ))
              }
            </ol><div class="demo-next">
              <p id="demo-description" aria-live="polite">
                Start with gAUSD already earning in an Euler vault.
              </p><button class="dark-button" id="demo-advance"
                ><span>Pick a bin</span><svg
                  class="arrow"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
                ></button
              ><button class="reset-button" id="demo-reset">Reset demo</button>
            </div>
          </div>
        </div>
      </section>
      <section class="access-section section-frame" id="network">
        <div class="section-heading">
          <h2>One terminal.<br />Every leg connected.</h2><p>
            For traders, bin builders, and developers composing positions across
            Monad's venues.
          </p>
        </div>
        <div class="access-columns">
          <article>
            <span class="small-label">BIN BUILDERS</span><h3>
              Bring a framing.<br />Let others take it.
            </h3><p>
              Pool assets around a theme, publish the analytics behind it, and
              let anyone size into the whole framing in one call.
            </p><a class="text-link" href="#assets"
              >Explore the bins <span aria-hidden="true">→</span></a>
          </article><article>
            <span class="small-label">DEVELOPER INFRASTRUCTURE</span><h3>
              Compose the legs.<br />Keep your own keys.
            </h3><p>
              Build against an EIP-7702 delegate on Monad. A passkey authorises a
              session key scoped to named targets and selectors; OpenCash never receives a private key.
            </p><details>
              <summary
                >View integration overview <span aria-hidden="true">+</span
                ></summary
              ><div class="integration-details">
                <p>
                  <code>OpenCashDelegate</code> verifies a WebAuthn assertion on
                  the P-256 precompile, then executes a batch of calls. Anything outside an
                  authorised scope is unreachable.
                </p><code
                  >authorizeSession(key, expiry, targets[], selectors[])<br
                  />executeWithSession(calls[], signature)<br
                  />verifyAndExecute(calls[], webAuthnAuth)<br
                  />revokeSession(key)<br />rotatePasskey(x, y)</code
                ><p>
                  Stated honestly: delegation adds a code path, it does not
                  remove the account key's own authority. What it removes is the app's ability to withdraw.
                </p>
              </div>
            </details>
          </article>
        </div>
      </section>
      <section
        class="closing scanner"
        data-scanner
        id="waitlist"
        aria-labelledby="closing-title"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          alt=""
          width="1376"
          height="768"
          loading="lazy"
        /><canvas class="scan-canvas" aria-hidden="true"></canvas><div
          class="closing-content"
        >
          <h2 id="closing-title">
            Every market.<br />One call.
          </h2><p class="closing-lede">
            OpenCash is not open yet. Leave an email and you will be told the day it is.
          </p><form class="waitlist" id="waitlist-form" method="post" action="/waitlist">
            <label class="visually-hidden" for="waitlist-email"
              >Email address</label
            ><input
              id="waitlist-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@domain.com"
            /><button class="light-button" type="submit"
              >Join waitlist <svg
                class="arrow"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
              ></button
            >
          </form><p class="waitlist-status" id="waitlist-status" role="status"></p>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark" href="#home"><Mark />open<span>cash</span></a><p>
          A full mobile trading terminal on Monad. Notional sizing, never debt.
        </p><div>
          <a href="#assets">Bins</a><a href="#platform">Platform</a><a
            href="#network">Developers</a
          ><a href="#about">About OpenCash</a>
        </div>
      </div><div class="footer-statement">
        Trade everything.<br /><span>Borrow nothing.</span>
      </div><div class="footer-bottom">
        <span>© {new Date().getFullYear()} OpenCash</span><span
          >In development · Monad Testnet</span
        ><a href="#home">Back to top ↑</a>
      </div>
    </footer>
    <script>
      import "../scripts/landing";
    </script>
  </body>
</html>
