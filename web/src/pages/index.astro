---
import "../styles/landing.css";
import "../styles/system.css";
import "../styles/start.css";
import Mark from "../components/Mark.astro";
const stages = [
  {
    name: "Fund",
    description:
      "Deposit USDC to Hyperliquid. One margin balance backs every position.",
    position: "issue",
  },
  {
    name: "Leverage",
    description:
      "Choose leverage per position. The cap scales with your deposit, so size never outruns the account.",
    position: "verify",
  },
  {
    name: "Bins",
    description:
      "Enter a whole narrative in one tap, or size a single leg inside it.",
    position: "collateral",
  },
  {
    name: "Settlement",
    description:
      "Your passkey signs every call. OpenCash never holds withdrawal power.",
    position: "settlement",
  },
];
const applications = [
  {
    id: "spot",
    tab: "Perps",
    audience: "FOR DIRECT TRADES",
    title: "Lever a single market.",
    text: "Go long or short on any Hyperliquid market with the leverage you choose. Orders start as post-only limits, so you set the price instead of chasing it.",
    image: "skyline",
    label: "PERPS / LEVERAGED TRADES",
    facts: [
      ["Venue", "Hyperliquid order book"],
      ["Leverage", "Capped by your deposit"],
      ["Orders", "Limit, post-only by default"],
    ],
  },
  {
    id: "usdg",
    tab: "USDC margin",
    audience: "FOR EVERY TRADE",
    title: "One balance backs every position.",
    text: "Deposit USDC once. It's the margin for every market and every bin, with no separate collateral step per trade.",
    image: "skyline",
    label: "USDC / MARGIN BALANCE",
    facts: [
      ["Asset", "USDC"],
      ["Used for", "Margin on every position"],
      ["Margin", "Cross or isolated, per position"],
    ],
  },
  {
    id: "bins",
    tab: "Bins",
    audience: "FOR ANYONE WITH A VIEW",
    title: "The narrative is the instrument.",
    text: "A bin groups markets that move together, like AI, energy or a theme in the headlines, into one position with a size per leg. Enter or rebalance the whole bin in one tap, on live prices.",
    image: "skyline-bins",
    label: "THEMATIC BINS / ONE POSITION",
    facts: [
      ["Composition", "Markets that move together"],
      ["Pricing", "Each leg live off the Hyperliquid order book"],
      ["Rebalance", "When you choose, never on a schedule"],
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="OpenCash is a trading terminal for Hyperliquid on phone and web. Trade any market with leverage capped to your deposit, or take a whole narrative in one bin."
    />
    <meta name="author" content="Daiwik Maheshwari" />
    <meta name="creator" content="Daiwik Maheshwari" />
    <meta name="publisher" content="OpenCash" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenCash" />
    <meta property="og:title" content="OpenCash — Leverage and bins on Hyperliquid" />
    <meta property="og:description" content="Leverage on any Hyperliquid market, and bins that take a whole narrative in one position, on phone and web." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="OpenCash — Leverage and bins on Hyperliquid" />
    <meta name="twitter:description" content="Leverage on any Hyperliquid market, and bins that take a whole narrative in one position, on phone and web." />
    <meta name="theme-color" content="#0b0f0e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/images/skyline.webp" as="image" />
    <title>OpenCash — Leverage and bins on Hyperliquid</title>
    <script is:inline>
      try {
        if (sessionStorage.getItem("logo-intro-seen")) document.documentElement.classList.add("logo-intro-skip");
        sessionStorage.setItem("logo-intro-seen", "1");
      } catch {}
    </script>
  </head>
  <body>
    <div class="logo-intro" aria-hidden="true"><Mark class="logo-intro__mark" /></div>
    <!-- THESIS: Reveal the market beneath the real world through an interactive photographic canvas.
      OWN-WORLD: Night skyline photography, saturated window colour, violet type, diamond anchors and pixel masks.
      STORY: Explore idle collateral, understand how a position forms, then interact with a clearly labelled product demo.
      FIRST VIEWPORT: Full-bleed skyline, centered floating navigation, cursor scanner, low single-line headline.
      FORM: User-pinned Geolava reference; original OpenCash content and canvas implementation.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="navigation" aria-label="Main navigation">
        <a class="wordmark" href="#home" aria-label="OpenCash home"
          ><Mark />open<span>cash</span></a
        >
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="nav-links"
          >Menu <span aria-hidden="true">+</span></button
        >
        <div class="nav-links" id="nav-links">
          <a href="#home" class="active">Home</a><a href="#assets">Bins</a
          ><a href="#platform">Platform</a><a href="#about">About</a
          ><a href="/dashboard">Sign in</a>
        </div>
        <a class="nav-cta" href="/dashboard"
          ><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
          > Launch app</a
        >
      </nav>
    </header>
    <main id="main">
      <section
        id="home"
        class="hero scanner"
        data-scanner
        aria-label="Interactive market landscape"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          width="1376"
          height="768"
          alt="A dense night skyline with one exchange tower lit in bands of colour"
          fetchpriority="high"
        />
        <canvas class="scan-canvas" aria-hidden="true"></canvas>
        <div class="hero-heading">
          <h1>Trade the narrative.<br class="mobile-break" /> With leverage.</h1><p>
            Bins of Hyperliquid markets that move together, sized and levered as one position, on your phone and the web.
          </p>
        </div>
        <div class="scan-controls">
          <button class="scan-toggle" aria-pressed="false"
            ><svg viewBox="0 0 16 16" aria-hidden="true"
              ><path d="M5 3v10M11 3v10"></path></svg
            ><span>Pause scan</span></button
          ><span class="scan-hint">Move to discover ↗</span>
        </div>
        <div class="hero-caption">
          <span class="status-dot"></span> Interactive visualisation <span
            >/</span
          > Illustrative, not live market data
        </div>
        <a class="scroll-cue" href="#about" aria-label="Discover OpenCash"
          ><svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M12 3v17m-6-6 6 6 6-6"></path></svg
          ></a
        >
      </section>
      <section class="intro section-frame" id="about">
        <h2>
          One terminal.<br />Every market.<br />Defined risk.
        </h2>
        <div class="intro-bottom">
          <span class="section-name"><i></i> WHY OPENCASH</span><p>
            A trading interface for Hyperliquid where a bin takes a whole
            narrative in one position, leverage is capped to your deposit, and every order starts as a limit.
          </p>
        </div>
        <span class="frame-node left"></span><span class="frame-node right"
        ></span>
      </section>
      <section
        class="asset-landscape scanner"
        data-scanner
        id="platform"
        aria-labelledby="landscape-title"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          width="1376"
          height="768"
          loading="lazy"
          alt="A night skyline annotated with the stages of an open position"
        />
        <canvas class="scan-canvas" aria-hidden="true"></canvas>
        <div class="pixel-edge" aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </div>
        <h2 id="landscape-title">One deposit.<br />A whole market.</h2>
        <div class="asset-pins">
          {
            stages.map((stage, i) => (
              <button
                class={`asset-pin ${stage.position}`}
                data-stage={i}
                aria-expanded={i === 0 ? "true" : "false"}
              >
                <>
                  <span class="pin-anchor" aria-hidden="true" />
                  <span class="pin-content">
                    <>
                      <span class="pin-title">
                        {stage.name}
                        <span aria-hidden="true">↗</span>
                      </span>
                      <span class="pin-description">{stage.description}</span>
                    </>
                  </span>
                </>
              </button>
            ))
          }
        </div>
        <span class="landscape-caption"
          >SELECT A POINT TO EXPLORE A POSITION</span
        >
      </section>
      <section
        class="connection section-frame"
        aria-labelledby="connection-title"
      >
        <div class="section-heading">
          <h2 id="connection-title">
            From a USDC balance<br />to an open position.
          </h2><p>
            OpenCash sits between your USDC balance and the
            Hyperliquid order book. Orders default to post-only limits, every size is checked against Hyperliquid's $10 minimum before it is sent, and every call is signed by your own passkey.
          </p>
        </div>
        <div
          class="connection-graphic"
          aria-label="USDC balance connects to leveraged markets, thematic bins, and passkey-signed settlement"
        >
          <svg
            class="connection-lines"
            viewBox="0 0 1000 360"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path
              d="M120 80H360L500 180 640 80H880M120 280H360L500 180 640 280H880M500 0V360"
            ></path><path class="flow-line" d="M120 80H360L500 180 640 280H880"
            ></path></svg
          >
          <div class="connection-center">
            <div class="diamond-stack" aria-hidden="true">
              <i></i><i></i><i></i>
            </div><Mark class="center-mark" /><strong>open</strong><span>CASH</span>
          </div>
          <span class="connection-label top-left">USDC balance</span
          ><span class="connection-label bottom-left"
            >Leveraged markets</span
          ><span class="connection-label top-right">Thematic bins</span
          ><span class="connection-label bottom-right"
            >Passkey-signed calls</span
          >
        </div>
        <div class="tech-strip">
          <span>BUILT ON</span><span class="chain-mark"
            ><b>Hyperliquid</b></span
          ><span>Order book</span><span
            >Passkey signing ↗</span>
        </div>
      </section>
      <section
        class="applications section-frame"
        id="assets"
        aria-labelledby="applications-title"
      >
        <div class="section-heading">
          <h2 id="applications-title">
            Trade a market.<br />Or a whole narrative.
          </h2><p>
            Leverage on any single market, one USDC balance behind every
            position, and bins that pool a narrative into one trade.
          </p>
        </div>
        <div
          class="application-tabs"
          role="tablist"
          aria-label="Trading surfaces"
        >
          {
            applications.map((app, i) => (
              <button
                id={`tab-${app.id}`}
                role="tab"
                aria-selected={i === 0}
                aria-controls={`panel-${app.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-tab={app.id}
              >
                {app.tab}
                <span aria-hidden="true">↗</span>
              </button>
            ))
          }
        </div>
        {
          applications.map((app, i) => (
            <div
              class="application-panel"
              id={`panel-${app.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${app.id}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <div class={`application-image ${app.id}-image`}>
                <>
                  <img
                    src={`/images/${app.image}.webp`}
                    alt={`Illustrative night skyline for ${app.tab.toLowerCase()}`}
                    loading="lazy"
                    width="1376"
                    height="768"
                  />
                  <span class="image-bracket" />
                  <span class="image-label">{app.label}</span>
                </>
              </div>
              <div class="application-content">
                <>
                  <span class="small-label">{app.audience}</span>
                  <h3>{app.title}</h3>
                  <p>{app.text}</p>
                  <dl>
                    {app.facts.map(([label, value]) => (
                      <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                  <a class="text-link" href="#explore">
                    Explore the flow{" "}
                    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 12h15m-6-6 6 6-6 6" />
                    </svg>
                  </a>
                </>
              </div>
            </div>
          ))
        }
        <p class="section-footnote">
          Proposed surfaces. OpenCash runs on Hyperliquid testnet during early access.
        </p>
      </section>
      <section
        class="demo-section section-frame"
        id="explore"
        aria-labelledby="demo-title"
      >
        <div class="section-heading">
          <h2 id="demo-title">See a position form.<br />Make the next move.</h2><p
          >
            A small, interactive look at the terminal we’re building. Walk a
            sample bin from a USDC balance to a signed order.
          </p>
        </div>
        <div class="demo-workspace">
          <div class="demo-summary">
            <span class="small-label"
              ><i class="status-dot"></i> INTERACTIVE DEMO</span
            ><h3>OpenCash Sample Bin</h3><p>
              Illustrative basket · No funds or transactions are sent.
            </p><div class="demo-asset-mark" aria-hidden="true">
              <svg viewBox="0 0 200 200"
                ><path
                  d="m100 20 80 45v75l-80 45-80-45V65Zm0 0v80m-80-35 80 35 80-35m-80 35v85m-80-45 80-40 80 40"
                ></path></svg>
            </div><span class="demo-caption"
              >A CLEAR PATH FROM IDEA TO POSITION</span>
          </div>
          <div class="demo-flow">
            <ol class="workflow-steps">
              {
                [
                  "Fund with USDC",
                  "Pick a bin",
                  "Set the size",
                  "Sign with your passkey",
                ].map((step, i) => (
                  <li data-demo-step={i} class={i === 0 ? "current" : ""}>
                    <>
                      <span class="step-number">0{i + 1}</span>
                      <span>{step}</span>
                      <span class="step-state">
                        {i === 0 ? "Ready" : "Upcoming"}
                      </span>
                    </>
                  </li>
                ))
              }
            </ol><div class="demo-next">
              <p id="demo-description" aria-live="polite">
                Start with USDC on Hyperliquid.
              </p><button class="dark-button" id="demo-advance"
                ><span>Pick a bin</span><svg
                  class="arrow"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
                ></button
              ><button class="reset-button" id="demo-reset">Reset demo</button>
            </div>
          </div>
        </div>
      </section>
      <section class="access-section section-frame" id="network">
        <div class="section-heading">
          <h2>One terminal.<br />Every leg connected.</h2><p>
            For traders, bin builders, and developers composing positions across
            Hyperliquid's markets.
          </p>
        </div>
        <div class="access-columns">
          <article>
            <span class="small-label">BIN BUILDERS</span><h3>
              Bring a narrative.<br />Let others take it.
            </h3><p>
              Group markets around a narrative, publish the reasoning behind it,
              and let anyone size into the whole bin in one tap.
            </p><a class="text-link" href="#assets"
              >Explore the bins <span aria-hidden="true">→</span></a>
          </article><article>
            <span class="small-label">DEVELOPER INFRASTRUCTURE</span><h3>
              Read the same markets.<br />Keep your own keys.
            </h3><p>
              Every bin is built from Hyperliquid's public market data, so each leg,
              weight and price is visible before you enter. OpenCash never receives a private key.
            </p><details>
              <summary
                >View integration overview <span aria-hidden="true">+</span
                ></summary
              ><div class="integration-details">
                <p>
                  Market data comes from Hyperliquid's public info API. Orders
                  go to its exchange API, checked against the $10 minimum before they are signed.
                </p><code
                  >loadTradeMarkets(info)<br
                  />placeLimitOrder(exchange, order)<br
                  />modifyOrder(exchange, orderId, order)<br
                  />setLeverage(exchange, asset, leverage)<br />updateIsolatedMargin(exchange, asset, amount)</code
                ><p>
                  Withdrawals only go to an address you have verified, and every
                  order runs on Hyperliquid testnet during early access.
                </p>
              </div>
            </details>
          </article>
        </div>
      </section>
      <section
        class="closing scanner"
        data-scanner
        id="waitlist"
        aria-labelledby="closing-title"
      >
        <img
          class="map-photo"
          src="/images/skyline.webp"
          alt=""
          width="1376"
          height="768"
          loading="lazy"
        /><canvas class="scan-canvas" aria-hidden="true"></canvas><div
          class="closing-content"
        >
          <h2 id="closing-title">
            Every market.<br />One call.
          </h2><p class="closing-lede">
            OpenCash is in early access. Sign in with a passkey to start
            trading, or leave an email and you'll be told when more opens up.
          </p><a class="light-button" href="/dashboard"
            >Sign in with passkey <svg
              class="arrow"
              viewBox="0 0 24 24"
              aria-hidden="true"
              ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
            ></a
          ><form class="waitlist" id="waitlist-form" method="post" action="/waitlist">
            <label class="visually-hidden" for="waitlist-email"
              >Email address</label
            ><input
              id="waitlist-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@domain.com"
            /><button class="light-button" type="submit"
              >Join waitlist <svg
                class="arrow"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path d="M4 12h15m-6-6 6 6-6 6"></path></svg
              ></button
            >
          </form><p class="waitlist-status" id="waitlist-status" role="status"></p>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark" href="#home"><Mark />open<span>cash</span></a><p>
          A trading terminal for Hyperliquid on phone and web. Leverage with a ceiling.
        </p><div>
          <a href="#assets">Bins</a><a href="#platform">Platform</a><a
            href="#network">Developers</a
          ><a href="#about">About OpenCash</a>
        </div>
      </div><div class="footer-statement">
        Trade the narrative.<br /><span>Size the risk.</span>
      </div><div class="footer-bottom">
        <span>© {new Date().getFullYear()} OpenCash</span><span
          >Early access · Hyperliquid testnet</span
        ><a href="#home">Back to top ↑</a>
      </div>
    </footer>
    <script>
      import "../scripts/landing";
    </script>
  </body>
</html>
