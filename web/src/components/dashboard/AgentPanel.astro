<section class="panel" data-panel="agent" hidden>
  <div class="bots-hero">
    <section class="card agent-panel">
      <div class="agent-panel__head">
        <span class="agent-avatar" aria-hidden="true">✦</span>
        <div>
          <b>Trading agent</b>
          <p class="agent__hint">Plain words in. A bot draft out. It never moves funds.</p>
        </div>
      </div>
      <div class="agent-chat" data-agent-chat>
        <div class="agent-msg">
          <div class="agent-bubble" data-agent-greeting>Hi! Tell me what you want in plain words. I check your balance and the markets myself, then draft a bot. You choose Paper or Live and press Start.</div>
        </div>
      </div>
      <div class="chip-row agent-prompts" data-agent-prompts>
        <button type="button" class="chip chip--lime" data-prompt="Long BTC with the smallest safe size, 2x, stop 6%">Safe BTC long</button>
        <button type="button" class="chip chip--sky" data-prompt="Pair trade: long MON, short BTC, 2x, stop 8%">MON vs BTC pair</button>
        <button type="button" class="chip chip--butter" data-prompt="Short PUMP 2x with a tight stop and a 10% target">Short PUMP</button>
        <button type="button" class="chip chip--peach" data-prompt="Use my whole free Perpl balance on the best funding carry right now">Best funding carry</button>
        <button type="button" class="chip chip--lime" data-prompt="Build a basket of ETH, SOL and HYPE longs at 2x with a 8% stop">ETH, SOL, HYPE basket</button>
      </div>
      <form class="agent__composer" data-agent-form>
        <input type="text" data-agent-input autocomplete="off" maxlength="600" placeholder="Ask for a trade, e.g. long MON short BTC 2x $100 stop 8%" />
        <button type="submit" class="btn btn--primary" data-agent-send>Send</button>
      </form>
      <p class="agent__hint" data-agent-hint></p>
    </section>

    <aside class="card auto-panel" data-auto-panel>
      <div class="auto-panel__top">
        <span class="botbar__dot" data-botbar-dot></span>
        <span class="auto-panel__label">Autonomous trading</span>
      </div>
      <b class="auto-panel__state" data-botbar-title>Off</b>
      <p class="agent__hint" data-trade-key-state></p>
      <button type="button" class="btn btn--primary" data-server-run>Start autonomous trading</button>
      <button type="button" class="btn" data-server-stop hidden>Stop autonomous trading</button>
      <div class="auto-panel__links">
        <button type="button" class="link-btn" data-live-stop-all>Pause all</button>
        <button type="button" class="link-btn" data-live-close-all>Stop all and close</button>
      </div>
      <p class="status-line" data-server-run-status></p>
      <p class="bots-note" data-bots-note>Deposit at least $10 before starting a bot. A bot skips any order under $10, so it can't trade with less.</p>
    </aside>
  </div>

  <div class="bots-row">
  <div class="agent">
    <aside class="agent__card card" data-agent-card>
      <span class="card__label">New bot</span>
      <p class="empty" data-card-empty>Ask the agent for a trade and the bot appears here.</p>
      <div data-card-body hidden>
        <div class="newbot">
          <div class="newbot__col">
            <label class="field"><span>Name</span><input data-card-name /></label>
            <div class="agent__row">
              <label class="field"><span>Margin $</span><input data-card-margin type="number" min="0" step="any" /></label>
              <label class="field"><span>Stop %</span><input data-card-stop type="number" min="0" step="any" /></label>
              <label class="field"><span>Target %</span><input data-card-tp type="number" min="0" step="any" /></label>
            </div>
            <div data-card-legs class="agent__legs"></div>
            <button type="button" class="link-btn" data-card-add>+ Add leg</button>
            <details class="agent__more">
              <summary>More rules</summary>
              <label class="field">
                <span>Signal (optional)</span>
                <select data-card-signal aria-label="Signal">
                  <option value="">None</option>
                  <option value="nansen">Nansen smart money must agree</option>
                </select>
              </label>
              <p class="quote-line" data-card-signal-note></p>
              <label class="field">
                <span>What it does</span>
                <select data-card-mode aria-label="Bot mode">
                  <option value="auto">Open a position for me and guard it</option>
                  <option value="guard">Only guard a position I already hold</option>
                </select>
              </label>
            </details>
          </div>
          <div class="newbot__col">
            <div data-card-preview class="agent__preview"></div>
            <div class="seg seg--wide" role="group" aria-label="Bot type">
              <button type="button" class="seg__btn" data-card-kind="paper" aria-pressed="true">Paper · fake money</button>
              <button type="button" class="seg__btn" data-card-kind="live" aria-pressed="false">Live · real money</button>
            </div>
            <button type="button" class="btn btn--primary" data-card-start>Start paper bot</button>
            <p class="status-line" data-card-status></p>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <section class="card agent__bots">
    <span class="card__label">Your bots</span>
    <p class="agent__hint" data-bot-hint></p>
    <div class="bots__list" data-bot-list>
      <p class="empty">No bots yet.</p>
    </div>
    <div class="bots__list" data-paper-list></div>
    <div class="bots__list" data-live-bot-list></div>
  </section>
  </div>

</section>
