<section class="panel" data-panel="trade" hidden>

  <div data-trade-list>
    <div class="board-widgets">
      <div class="card card--balance widget widget--account">
        <div class="balance-head">
          <span class="card__label">Perpl account</span>
          <span class="chain-badge">Monad Testnet</span>
        </div>
        <span class="stat-card__value stat-card__value--lg trade-mono" data-trade-balance>—</span>
        <div class="balance-meta">
          <span class="trade-mono" data-trade-updated>—</span>
          <button type="button" class="link-btn" data-trade-refresh>⟳ Refresh</button>
        </div>
        <p class="trade-note" data-trade-wallet-note></p>
      </div>
      <div class="card widget" data-widget-volume><small class="widget__sub">Loading…</small></div>
      <div class="card widget" data-widget-funding><small class="widget__sub">Loading…</small></div>
      <div class="card widget widget--list" data-widget-gainers><small class="widget__sub">Loading…</small></div>
      <div class="card widget widget--list" data-widget-carry><small class="widget__sub">Loading…</small></div>
    </div>

    <div class="card board">
      <div class="board-bar">
        <div class="chip-row" data-board-filters></div>
        <input type="search" class="search-field board-search" data-trade-search placeholder="Search assets" autocomplete="off" />
      </div>
      <div class="table-wrap board-wrap" data-board-table><p class="empty">Loading markets…</p></div>
    </div>

    <div class="card">
      <span class="panel__label">Open positions</span>
      <div data-trade-desk class="table-wrap table-wrap--loading">Loading…</div>
      <p class="status-line" data-trade-desk-status></p>
    </div>
  </div>

  <div data-trade-asset hidden>
    <button type="button" class="back-btn" data-trade-back><span aria-hidden="true">←</span> All assets</button>
    <div class="trade-asset-grid">
      <div class="trade-asset-main">
        <div class="card card--chart card--violet">
          <span class="card__label" data-trade-market-label>—</span>
          <div class="chart-value-row">
            <span class="stat-card__value trade-mono" data-trade-market-price>—</span>
            <span class="chart-change" data-trade-market-meta></span>
          </div>
          <div class="chip-row" data-trade-range>
            <button type="button" class="chip" data-range="1h">1H</button>
            <button type="button" class="chip" data-range="4h">4H</button>
            <button type="button" class="chip chip--active" data-range="1d">1D</button>
            <button type="button" class="chip" data-range="1w">1W</button>
            <button type="button" class="chip" data-range="1m">1M</button>
          </div>
          <div class="chart-area" data-trade-chart></div>
        </div>
        <div class="card">
          <span class="panel__label">Market details</span>
          <div class="stat-grid" data-trade-stats><p class="empty">Loading…</p></div>
          <p class="panel__lede">Positive funding means longs pay shorts. Figures come from Perpl on Monad testnet.</p>
        </div>
      </div>

      <aside class="trade-ticket-bar">
        <div class="card trade-ticket">
          <span class="card__label" data-trade-ticket-title>Order</span>
          <div class="mode-row">
            <button type="button" class="chip chip--active" data-side="long">Long</button>
            <button type="button" class="chip" data-side="short">Short</button>
          </div>
          <label class="field"><span>Margin (AUSD)</span><input type="number" min="0" step="any" data-ticket-margin /></label>
          <label class="field"><span>Leverage</span><input type="number" min="1" step="1" value="3" data-ticket-leverage /></label>
          <p class="quote-line" data-ticket-size></p>
          <div class="cost" data-ticket-cost hidden></div>
          <button type="button" class="btn btn--primary" data-ticket-submit>Place order</button>
          <p class="status-line" data-ticket-status></p>
        </div>
      </aside>
    </div>
  </div>
</section>
