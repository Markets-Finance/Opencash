    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@neondatabase/serverless": "1.1.0",
    "fastify": "^5.2.1",
    "shared": "workspace:*",
    "viem": "^2.22.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
